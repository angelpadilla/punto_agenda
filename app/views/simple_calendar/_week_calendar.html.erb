<div class="bold has-text-neon calendar-title">
  <%= t('simple_calendar.week', default: 'Week') %>
  <%= calendar.week_number %>
  <% if calendar.number_of_weeks > 1 %>
    - <%= calendar.end_week %>
  <% end %>
</div>
<%= render 'simple_calendar/actions', calendar: calendar %>
<div class="simple-calendar week mt-4">
  <nav class="simple-calendar-nav" aria-label="Days of the week">
    <% date_range.slice(0, 7).each do |day| %>
      <div>
        <%= t('date.abbr_day_names')[day.wday].titleize %>
      </div>
    <% end %>
  </nav>
  <table>
    <thead>
      <tr>
        <% date_range.slice(0, 7).each do |day| %>
          <th><%= t('date.abbr_day_names')[day.wday].titleize %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% date_range.each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <%= content_tag :td, class: "#{calendar.td_classes_for(day).join(' ')} #{'not-working-day' unless @corp.working_day?(day)}" do %>
              <% instance_exec(day, calendar.sorted_events_for(day), &passed_block) %>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
