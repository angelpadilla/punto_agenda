<%= render 'user_panel/events/button_selector' %>
<div class="flexx space-b flex-end mt-4">
  <div class="buttons has-addons events_actions">
    <%= link_to calendar.url_for_previous_view, data: {turbo: false}, class: "button" do %>
      <span class=" material-icons-round">arrow_left</span>
      <%= t('simple_calendar.previous', default: 'Anterior') %>
    <% end %>
    <%= link_to calendar.url_for_today_view, data: {turbo: false}, class: "button" do %>
      <%= t('simple_calendar.today', default: 'Hoy') %>
    <% end %>
    <%= link_to calendar.url_for_next_view, data: {turbo: false}, class: "button" do %>
      <%= t('simple_calendar.next', default: 'Siguiente') %>
      <span class=" material-icons-round">arrow_right</span>
    <% end %>
  </div>
  <div class="actions">
    <div class="button is-rounded">
      <span class="icon">
        <%= image_tag 'search2.svg', alt: 'filter', class: 'invert' %>
      </span>
    </div>
    <%= link_to new_event_path, class: "button is-primary is-rounded" do  %>
      <span class="icon mr-2">
        <%= image_tag 'calendar_plus.svg', alt: 'carrito' %>
      </span>
      Nuevo evento
    <% end %>
  </div>
</div>