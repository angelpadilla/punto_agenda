<nav class="is-hidden-touch navbar is-black is-fixed-top" role="navigation" aria-label="main navigation">
  <div class="container">
    <div class="navbar-brand">
      <%= link_to root_path, class: 'navbar-item' do %>
        <%= image_tag 'logo2.svg', height: '200px', class: 'logo', alt: 'fresh club logo' %>
      <% end %>
    </div>
    <div id="navbarBasicExample" class="navbar-menu">
      <div class="navbar-start">
      </div>
      <div class="navbar-end">
        <% if user_signed_in? %>
          <div class="navbar-item">
            <%= link_to user_panel_home_path, class: 'button is-rounded is-primary is-fullwidth has_tooltip' do %>
              <span class="icon">
                <%= image_tag 'shop.svg', alt: 'login' %>
              </span>
              <span>Panel</span>
              <span class="tooltip down">Ir a mi panel de control</span>
            <% end %>
          </div>
        <% else %>
          <div class="navbar-item">
            <%= link_to new_user_session_path, class: 'button is-rounded is-primary is-fullwidth has_tooltip' do %>
              <span class="icon">
                <%= image_tag 'login.svg', alt: 'login' %>
              </span>
              <span>Acceder</span>
              <span class="tooltip down">Ir a inicio de sesión</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</nav>
<% if user_signed_in? %>
  <div class="is-hidden-desktop nav_movil">
    <div class="inner">
      <%= link_to root_path, class: 'icon' do %>
        <%= image_tag 'house.svg', alt: 'inicio', class: 'invert' %>
      <% end %>
      <% if current_user.can_view? :order %>
        <%= link_to root_path, class: 'icon' do %>
          <span class="icon">
            <%= image_tag 'dollar.svg', alt: 'carrito', class: 'invert' %>
          </span>
        <% end %>
      <% end %>
      <% if current_user.can_view? :item or current_user.mayorista? %>
        <%= link_to root_path, class: 'icon' do %>
          <span class="icon">
            <%= image_tag 'items.svg', alt: 'carrito', class: 'invert' %>
            <% if 1 > 0 %>
              <div class="notification_dot2"></div>
            <% end %>
          </span>
        <% end %>
      <% end %>
      <% if (current_user.can_view? :customer or current_user.can_view? :provider) %>
        <%= link_to root_path, class: 'icon' do %>
          <span class="icon">
            <%= image_tag 'clientes.svg', alt: 'carrito', class: 'invert' %>
          </span>
        <% end %>
      <% end %>
      <% if current_user.can_view? :purchase %>
        <%= link_to root_path, class: 'icon' do %>
          <span class="icon">
            <%= image_tag 'compras.svg', alt: 'carrito', class: 'invert' %>
          </span>
        <% end %>
      <% end %>
      <% if current_user.admin? %>
        <%= link_to root_path, class: 'icon' do %>
          <span class="icon">
            <%= image_tag 'opciones.svg', alt: 'carrito', class: 'invert' %>
          </span>
        <% end %>
      <% end %>
      <%= link_to root_path, class: 'icon' do %>
        <%= image_tag 'user.svg', alt: 'mi perfil', class: 'invert' %>
      <% end %>
    </div>
  </div>
<% end %>
