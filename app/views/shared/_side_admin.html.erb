<div class="column is-2">
  <aside class="menu">
    <p class="menu-label">
      Panel de control
    </p>
    <%=  %>
    <ul class="menu-list">
      <li>
        <a href="<%= admin_panel_home_path %>" class=" <%= request.path == '/admin' ? 'is-active' : '' %>">
          <span class="icon mr-2">
            <%= image_tag 'course-up-svgrepo-com.svg', alt: "Configuración" %>
          </span>
          Resumen
        </a>
      </li>
      <li>
        <a href="<%= admin_bills_path %>" class="<%= request.path.include?('bill') ? 'is-active' : '' %>">
          <span class="icon mr-2">
            <%= image_tag 'dollar.svg', alt: "Configuración" %>
          </span>
          Facturacion
        </a>
      </li>
      <li>
        <a href="<%= admin_corps_path %>" class="<%= request.path.include?('corp') ? 'is-active' : '' %>">
          <span class="icon mr-2">
            <%= image_tag 'crown-star-svgrepo-com.svg', alt: "Configuración" %>
          </span>
          Clientes (Negocios)
        </a>
      </li>
      <% if current_admin.admin? %>
        <li>
          <a href="<%= admin_admins_path %>" class="<%= request.path.include?('admins') ? 'is-active' : '' %>">
            <span class="icon mr-2">
              <%= image_tag 'user.svg', alt: "Configuración" %>
            </span>
            Equipo
          </a>
        </li>
      <% end %>
      <li>
        <a href="<%= posts_path %>" class="<%= request.path.include?('post') ? 'is-active' : '' %>">
          <span class="icon mr-2">
            <%= image_tag 'planet-3-svgrepo-com.svg', alt: "Configuración" %>
          </span>
          Articulos 
        </a>
      </li>
    </ul>
  </aside>
</div>