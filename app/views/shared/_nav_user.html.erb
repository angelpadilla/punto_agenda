<nav class="is-hidden-touch navbar is-black is-fixed-top" role="navigation" aria-label="main navigation">
  <div class="container">
    <div class="navbar-brand">
      <%= link_to user_panel_home_path, class: 'navbar-item' do %>
        <%= image_tag 'logo2.svg', height: '200px', class: 'logo', alt: 'fresh club logo' %>
      <% end %>
    </div>
    <div id="navbarBasicExample" class="navbar-menu">
      <% if user_signed_in? %>
        <div class="navbar-start">
          <%= link_to user_panel_home_path, class: 'navbar-item has_tooltip' do %>
            <span class="icon">
              <%= image_tag 'house.svg', alt: 'carrito', class: 'invert' %>
            </span>
            <div class="tooltip down">inicio</div>
          <% end %>
          <% if current_user.can_view? :order %>
            <%= link_to user_panel_home_path, class: 'navbar-item has_tooltip' do %>
              <span class="icon">
                <%= image_tag 'dollar.svg', alt: 'carrito', class: 'invert' %>
              </span>
              <div class="tooltip down">ventas</div>
            <% end %>
          <% end %>
          <% if current_user.can_view? :item %>
            <%= link_to items_path, class: 'navbar-item has_tooltip' do %>
              <span class="icon">
                <%= image_tag 'items.svg', alt: 'carrito', class: 'invert' %>
              </span>
              <div class="tooltip down">inventario</div>
            <% end %>
          <% end %>
          <% if (current_user.can_view? :customer or current_user.can_view? :provider) %>
            <%= link_to user_panel_home_path, class: 'navbar-item has_tooltip' do %>
              <span class="icon">
                <%= image_tag 'clientes.svg', alt: 'carrito', class: 'invert' %>
              </span>
              <div class="tooltip down">clientes y proveedores</div>
            <% end %>
          <% end %>
          <% if current_user.can_view? :purchase %>
            <%= link_to user_panel_home_path, class: 'navbar-item has_tooltip' do %>
              <span class="icon">
                <%= image_tag 'compras.svg', alt: 'carrito', class: 'invert' %>
              </span>
              <div class="tooltip down">compras y gastos</div>
            <% end %>
          <% end %>
          <% if current_user.admin? %>
            <%= link_to user_panel_home_path, class: 'navbar-item has_tooltip' do %>
              <span class="icon">
                <%= image_tag 'opciones.svg', alt: 'carrito', class: 'invert' %>
              </span>
              <div class="tooltip down">opciones</div>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <div class="navbar-end">
        <% if @carrito and !@carrito.line_items&.empty? %>
          <div class="navbar-item has-dropdown is-hoverable">
            <a class="navbar-link">
              <span class="icon">
                <%= image_tag 'cart.svg', alt: 'carrito' %>
                <div class="tooltip down">Carrito</div>
                <div class="notification_dot"></div>
              </span>
            </a>
            <div class="navbar-dropdown is-boxed is-right">
              <div class="navbar-item">
                <strong><%= @carrito.line_items.sum(:cantidad) %> item(s)</strong>
              </div>
              <div class="navbar-item">
                <strong>Total: <%= number_to_currency @carrito.line_items.sum { |line| line.total } %></strong>
              </div>
              <hr class="navbar-divider">
              <div class="navbar-item">
                <%= link_to 'Ver carrito', new_order_path, class: 'button is-fullwidth' %>
              </div>
            </div>
          </div>
        <% end %>
        <% if user_signed_in? %>
          <div class="navbar-item has-dropdown is-hoverable">
            <a class="navbar-link">
              <span class="icon">
                <%= image_tag 'user.svg', alt: 'user', class: 'invert' %>
              </span>
            </a>
            <div class="navbar-dropdown is-boxed is-right">
              <div class="navbar-item">
                <%= current_user.email %>
              </div>
              <%= link_to user_panel_home_path, class: 'navbar-item' do  %>
                <span class="icon">
                  <%= image_tag 'opciones.svg', alt: 'inicio', class: 'invert' %>
                </span>
                Mi empresa
              <% end %>
              <%= link_to user_panel_home_path, class: 'navbar-item' do  %>
                <span class="icon">
                  <%= image_tag 'user.svg', alt: 'inicio', class: 'invert' %>
                </span>
                Mi perfil
              <% end %>
              <%= link_to user_panel_home_path, class: 'navbar-item' do  %>
                <span class="icon">
                  <%= image_tag 'dollar.svg', alt: 'inicio', class: 'invert' %>
                </span>
                Facturación
              <% end %>
              <hr class="navbar-divider">
              <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: 'navbar-item' do %>
                <span class="icon">
                  <%= image_tag 'login.svg', alt: 'Salir', class: 'invert' %>
                </span>
                Salir
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="navbar-item">
            <%= link_to new_user_session_path, class: 'button is-rounded is-primary is-fullwidth has_tooltip' do %>
              <span class="icon">
                <%= image_tag 'login.svg', alt: 'login' %>
              </span>
              <span>Acceder</span>
              <span class="tooltip down">esto es un tooltip</span>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</nav>
<% if user_signed_in? %>
  <div class="is-hidden-desktop nav_movil_user">
    <div class="inner">
      <%= link_to user_panel_home_path, class: 'icon' do %>
        <%= image_tag 'house.svg', alt: 'inicio', class: 'invert' %>
      <% end %>
