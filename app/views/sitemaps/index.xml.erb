<?xml version="1.0" encoding="UTF-8"?>
  <sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    <% @pages.each do |page| %>
      <sitemap>
        <loc><%= page[:loc] %></loc>
        <lastmod><%= page[:lastmod].strftime('%Y-%m-%d') %></lastmod>
      </sitemap>
    <% end %>
  </sitemapindex>
