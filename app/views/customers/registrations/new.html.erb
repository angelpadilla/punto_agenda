<div class="login">
  <div class="login_ad_box flexx-1">
    <div class="header">
      <div class="logo_container">
        <%= image_tag 'logo2.svg', alt: 'MiiNegocio', class: 'logo' %>
      </div>
      <%= link_to root_path, class: "button is-rounded is-success" do %>
        <span class="icon">
          <%= image_tag 'login.svg', alt: 'login' %>
        </span>
        <span>Regresar a inicio</span>
      <% end %>
    </div>
    <div class="footerr">
      ¿Ya tienes una cuenta? <%= link_to "Inicia sesión aquí", new_session_path(resource_name), class: "has-text-success" %>
    </div>
    <div class="img_cont"></div>
  </div>
  <div class="login_box flexx-1" style="height: auto;">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: 'login_form' }) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>
      <div class="cf-turnstile" data-size='flexible' data-sitekey="<%= Rails.application.credentials.dig(Rails.env.to_sym, :turnstile, :site_key) %>"></div>
      <div class="login_box_textt">
        <div class="login_box_logo">
          <%= image_tag 'logo2.svg', alt: 'MiiNegocio', class: 'logo' %>
        </div>
        <div class="login_box_title">Registro usuario</div>
      </div>
      <div class="field">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input is-rounded #{f.object.errors.include?(:email) ? 'is-danger' : ''}", placeholder: 'Email', required: true %>
      </div>
      <div class="field">
        <%= f.password_field :password, autocomplete: "new-password", class: "input is-rounded #{f.object.errors.include?(:password) ? 'is-danger' : ''}", placeholder: "Contraseña (#{@minimum_password_length} caracteres mínimo)", required: true %>
      </div>
      <div class="field">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input is-rounded #{f.object.errors.include?(:password_confirmation) ? 'is-danger' : ''}", placeholder: 'Confirmar Contraseña', required: true %>
      </div>
      <button type="submit" class="button is-rounded is-primary is-fullwidth">
        <span class="icon mr-2">
          <%= image_tag 'login.svg', alt: 'login' %>
        </span>
        Registro
      </button>
      <hr>
      <% if false %>
        <div class="buttons">
          <%= link_to root_path, class: "button is-rounded is-link is-fullwidth" do %>
            <span class="icon mr-4">
              <%= image_tag 'google.svg', alt: 'Google' %>
            </span>
            Registro con Google
          <% end %>
        </div>
      <% end %>
      <p class="help">
        Al registrarte, estás aceptando nuestros <%= link_to "Términos y condiciones", terminos_path, target: "_blank" %> y nuestra <%= link_to "Política de privacidad", privacidad_path, target: "_blank" %>.
      </p>
      <br>
      <%= render "users/shared/links" %>
    <% end %>
  </div>
</div>