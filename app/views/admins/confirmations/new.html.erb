<% content_for :title, "Reenvia instrucciones de confirmación" %>
<% @body_class = 'login' %>
<div class="container">
  <div class="boxx has-text-centered">
    <%= link_to root_path do  %>
      <%= image_tag 'logo2.svg', class: "logo_login", alt: 'logo' %>
    <% end %>
    <h1 class="title is-4">Reenvia instrucciones de confirmación</h1>
    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f| %>
      <div class="field">
        <div class="control">
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'input', placeholder: 'Email', required: true, value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %>
        </div>
      </div>
      <%= f.submit "Reenvia instrucciones", class: 'button is-block is-fullwidth' %>
      <br>
      <%= render "users/shared/links" %>
    <% end %>
  </div>
</div>