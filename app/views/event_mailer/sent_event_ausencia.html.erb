<table border="0" cellpadding="0" cellspacing="0" class="body">
  <tr>
    <td>&nbsp;</td>
    <td class="container">
      <div class="content">
        <!-- START CENTERED WHITE CONTAINER -->
        <table class="main">
          <!-- START MAIN CONTENT AREA -->
          <tr>
            <td class="wrapper">
              <table border="0" cellpadding="0" cellspacing="0">
                <tr>
                  <td>
                    <h2>Cita no asistida</h2>
                    <p>Lamentamos informarte que no pudiste asistir a tu cita/evento con <b><%= @corp.name&.titleize %></b>.</p>
                    <br>
                    <p>
                      <b>Cliente:</b> <%= @event.customer&.razon&.titleize %>
                    </p>
                    <p>
                      <b>Folio:</b> <%= @event.folio %>
                    </p>
                    <p>
                      <b>Día:</b> <%= @event.hora_inicio.strftime("%d/%m/%Y") %>
                    </p>
                    <p>
                      <b>Hora:</b> <%= @event.hora_inicio.strftime("%I:%M %p") %> - <%= @event.hora_final.strftime("%I:%M %p") %>
                    </p>
                    <p>
                      <b>Agente:</b> <%= @event.user&.full_name&.titleize %>
                    </p>
                    <p>Si tienes dudas o comentarios, no dudes en contactarnos.</p>
                    <p>
                      <b>Tel/whatsapp: </b><%= @event.corp&.tel_prefix %> <%= @event.corp.phone %>
                    </p>
                    <br>
                    <p>Gracias por tu preferencia, que tengas un excelente día.</p>
                    <br>
                    <p>
                      *Recuerda que al no asistir a tu cita/evento pierdes tu depósito y puede afectar tu historial como cliente. Si necesitas asistencia, contáctanos lo antes posible.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <!-- END MAIN CONTENT AREA -->
        </table>
        <!-- START FOOTER -->
        <div class="footer">
          <table border="0" cellpadding="0" cellspacing="0">
            <tr>
              <td class="content-block">
                <span class="apple-link">Software desarrollado por &copy; Ghoster, todos los derechos reservados.</span>
                <br>
                <a href="https://ghoster.mx/">www.ghoster.mx</a>.
              </td>
            </tr>
          </table>
        </div>
        <!-- END FOOTER -->
        <!-- END CENTERED WHITE CONTAINER -->
      </div>
    </td>
    <td>&nbsp;</td>
  </tr>
</table>