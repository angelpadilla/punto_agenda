<% content_for :title, "Eventos en la semana" %>
<h2 class="titlee">Eventos en la semana</h2>
<%= week_calendar(number_of_weeks: 1, events: @events) do |date, events| %>
  <% info_day = @corp.available_slots_for_day(date) %>
  <div class="day_number flexx vertical-center horizontal-center mtrigger" data-target="date_info_<%= date.strftime('%Y%m%d') %>">
    <%# date.day %>
    <%= date.day %>
    <%# icono info y modal para mas detalles del dia %>
    <span class="icon">
      <%= image_tag 'info.svg', alt: 'info', class: 'invert', loading: 'lazy' %>
    </span>
    <br>
    <% if info_day %>
      <progress class="progress is-neon" value="<%= info_day[:ocupados] %>" max="<%= info_day[:total] %>"></progress>
    <% else %>
      <progress class="progress is-danger" value="1" max="1"></progress>
    <% end %>
  </div>
  <%# modal for date_info %>
  <div id="date_info_<%= date.strftime('%Y%m%d') %>" class="modal">
    <div class="modal-background"></div>
    <div class="modal-content">
      <div class="box">
        <% if info_day %>
          <h3 class="title is-4">Info completa del <%= l(date, format: :long) %></h3>
          <div class="mt-4 flexx">
            <span class="icon material-icons-round mr-2">assignment_ind</span>
            <div>
              <p class="labell">Total: </p>
              <p><%= info_day[:total] %></p>
            </div>
          </div>
          <div class="mt-4 flexx">
            <span class="icon material-icons-round mr-2">assignment_ind</span>
            <div>
              <p class="labell">Disponibles: </p>
              <p><%= info_day[:disponibles] %></p>
            </div>
          </div>
          <div class="mt-4 flexx">
            <span class="icon material-icons-round mr-2">assignment_ind</span>
            <div>
              <p class="labell">Ocupados: </p>
              <p><%= info_day[:ocupados] %></p>
            </div>
          </div>
          <div class="mt-4 flexx">
            <span class="icon material-icons-round mr-2">assignment_ind</span>
            <div>
              <p class="labell">Porcentaje de ocupación: </p>
              <p><%= info_day[:pct] %>%</p>
            </div>
          </div>
          <div class="mt-4 flexx">
            <span class="icon material-icons-round mr-2">assignment_ind</span>
            <div>
              <p class="labell">Abre: </p>
              <p><%= info_day[:first_open] %></p>
            </div>
          </div>
          <div class="mt-4 flexx">
            <span class="icon material-icons-round mr-2">assignment_ind</span>
            <div>
              <p class="labell">Cierra: </p>
              <p><%= info_day[:last_close] %></p>
            </div>
          </div>
        <% else %>
          <p class="has-text-grey">Día no laborable</p>
        <% end %>
      </div>
    </div>
    <button class="modal-close is-large" aria-label="close"></button>
  </div>
  <% if info_day %>
    <% info_day[:slots].each do |slot| %>
      <div class="event_snippet mtrigger" data-target="slot_<%= date.strftime('%Y%m%d') %>_<%= slot[:index] %>">
        <% if slot[:fully_booked] %>
          <span class="tag is-rounded is-danger">Lleno total</span>
        <% else %>
          <span class="tag is-rounded is-success">Disponible</span>
        <% end %>
        <div class="snippet_body">
          <%= slot[:start] %> - <%= slot[:end] %>
        </div>
      </div>
      <%# modal %>
      <div id="slot_<%= date.strftime('%Y%m%d') %>_<%= slot[:index] %>" class="modal">
        <div class="modal-background"></div>
        <div class="modal-content">
          <div class="box">
            <h3 class="title is-4">Info del slot <%= slot[:start] %> - <%= slot[:end] %></h3>
            <div class="mt-4 flexx">
              <span class="icon material-icons-round mr-2">assignment_ind</span>
              <div>
                <p class="labell">Estado: </p>
                <% if slot[:fully_booked] %>
                  <span class="tag is-rounded is-danger">Lleno</span>
                <% else %>
                  <span class="tag is-rounded is-success">Disponible</span>
                <% end %>
              </div>
            </div>
            <div class="mt-4 flexx">
              <span class="icon material-icons-round mr-2">assignment_ind</span>
              <div>
                <p class="labell">Agentes libres: </p>
                <p><%= slot[:agentes_libres] %></p>
              </div>
            </div>
            <div class="mt-4 flexx">
              <span class="icon material-icons-round mr-2">assignment_ind</span>
              <div>
                <p class="labell">Agentes ocupados: </p>
                <p><%= slot[:agentes_ocupados] %></p>
              </div>
            </div>
            <div class="mt-4 flexx">
              <span class="icon material-icons-round mr-2">assignment_ind</span>
              <div>
                <p class="labell">Agentes ocupantes: </p>
                <% if slot[:booked_agent_ids].any? %>
                  <ul>
                    <% slot[:booked_agent_ids].each do |user_id| %>
                      <% agent = @corp.users.find { |a| a.id == user_id } %>
                      <li><%= agent&.full_name || "Agente ##{user_id}" %></li>
                    <% end %>
                  </ul>
                <% else %>
                  <p>Ninguno</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <button class="modal-close is-large" aria-label="close"></button>
      </div>
    <% end %>
  <% end %>
  <% if false %>
    <% events.each do |event| %>
      <%= render 'snippet', event: event %>
    <% end %>
  <% end %>
<% end %>