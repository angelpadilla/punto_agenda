<% content_for :title, "Historial eventos" %>
<div class="flexx space-b flex-end mb-4">
  <h2 class="titlee">Historial de eventos</h2>
  <div class="actions">
    <div class="button is-rounded mtrigger" data-target="search_modal">
      <span class="icon">
        <%= image_tag 'search2.svg', alt: 'filter', class: 'invert' %>
      </span>
    </div>
    <%= link_to new_event_path, class: "button is-primary is-rounded" do %>
      <span class="icon mr-2">
        <%= image_tag 'calendar_plus.svg', alt: 'nuevo evento' %>
      </span>
      Nuevo evento
    <% end %>
  </div>
</div>
<div class="flexx gap-1 mt-4">
  <%= link_to events_path, class: "button is-rounded  #{action_name == 'index' ? 'is-primary' : '' }" do %>
    <span class="icon mr-2">
      <%= image_tag 'layers.svg', alt: 'back', class: action_name == 'index' ? '' : 'invert' %>
    </span>
    Historial
  <% end %>
  <% if false %>
    <%= link_to daily_events_path, class: "button is-rounded #{action_name == 'daily' ? 'is-primary' : '' }", data: {turbo: false} do %>
      <span class="icon mr-2">
        <%= image_tag 'calendar.svg', alt: 'filter', class: action_name == 'daily' ? '' : 'invert' %>
      </span>
      Dia
    <% end %>
  <% end %>
  <%= link_to weekly_events_path, class: "button is-rounded #{action_name == 'weekly' ? 'is-primary' : '' }", data: {turbo: false} do %>
    <span class="icon mr-2">
      <%= image_tag 'calendar.svg', alt: 'filter', class: action_name == 'weekly' ? '' : 'invert' %>
    </span>
    Semana
  <% end %>
  <%= link_to monthly_events_path, class: "is-hidden-touch button is-rounded #{action_name == 'monthly' ? 'is-primary' : '' }", data: {turbo: false} do %>
    <span class="icon mr-2">
      <%= image_tag 'calendar.svg', alt: 'filter', class: action_name == 'monthly' ? '' : 'invert' %>
    </span>
    Mes
  <% end %>
  <% if @por_confirmar > 0 %>
    <%= link_to events_path(q: { status_eq: 3 }), class: "button is-rounded is-warning" do %>
      <span class="icon mr-2">
        <%= image_tag 'danger-triangle-svgrepo-com.svg', alt: 'filter', class: '' %>
      </span>
      Por confirmar
      <span class="tag is-rounded ml-2"><%= @por_confirmar %></span>
    <% end %>
  <% end %>
</div>
<div class="table-container">
  <table class="table is-fullwidth is-hoverable mt-4">
    <thead>
      <tr>
        <th></th>
        <th class="table_cell"><%= sort_link(@q, :title, 'Título') %></th>
        <th class="table_cell"><%= sort_link(@q, :customer_id, 'Cliente') %></th>
        <th class="table_cell"><%= sort_link(@q, :user_id, 'Agente/Vendedor') %></th>
        <th class="table_cell">Fecha creacion</th>
        <th class="table_cell"><%= sort_link(@q, :hora_inicio, 'Fecha espacio (slot)') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render @events %>
    </tbody>
  </table>
</div>
<% if @pagy.pages > 1 %>
  <br>
  <%== @pagy.series_nav(:bulma) %>
  <br>
<% end %>
<br>
<br>
<%# modal %>
<div id="search_modal" class="modal">
  <div class="modal-background"></div>
  <div class="modal-content">
    <div class="box">
      <%= search_form_for @q, url: events_path do |f| %>
        <div class="columns is-multiline">
          <div class="column is-12">
            <%= f.search_field :folio_eq, class: 'input is-rounded', placeholder: 'Folio' %>
          </div>
          <div class="column is-6">
            <div class="control">
              <%= f.select :customer_id_eq,
                options_for_select(@customers.map {|c| ["#{c.razon} #{c.tel_prefix} #{c.tel}", c.id]}, @q.customer_id_eq),
                { prompt: "Cliente" },
                { "data-controller": "slimselect", class: "ss2",}
              %>
            </div>
          </div>
          <div class="column is-6">
            <div class="control">
              <%= f.select :user_id_eq,
                options_for_select(@users.map {|u| [u.full_name, u.id]}, @q.user_id_eq),
                { prompt: "Agente/Vendedor" },
                { "data-controller": "slimselect", class: "ss2",}
              %>
            </div>
          </div>
          <div class="column is-6">
            <div class="select is-rounded">
              <%= f.select :status_eq, options_for_select(Event.statuses.map {|k, v| [k.humanize, v]}, @q.status_eq), {prompt: "Status"}, {class: ""} %>
            </div>
          </div>
          <div class="column is-6">
            <div class="select is-rounded">
              <%= f.select :canal_eq, options_for_select(Event.canals.map {|k, v| [k.humanize, v]}, @q.canal_eq), {prompt: "Canal"}, {class: ""} %>
            </div>
          </div>
        </div>
        <%= f.submit 'Buscar', class: "button is-rounded is-primary is-fullwidth" %>
      <% end %>
    </div>
  </div>
</div>