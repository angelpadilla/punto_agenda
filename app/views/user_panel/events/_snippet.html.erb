<div class="snippet_slot flexx space-b vertical-center mtrigger <%= 'glow-warning' if event.por_confirmar? %>" data-target="event_<%= identifier %><%= event.id %>">
  <div class="snippet_body">
    <% if event.agendado? %>
      <span class="tag is-rounded"><%= event.status&.titleize %></span>
    <% elsif event.completado? %>
      <span class="tag is-rounded is-success"><%= event.status&.titleize %></span>
    <% elsif event.cancelado? %>
      <span class="tag is-rounded is-danger"><%= event.status&.titleize %></span>
    <% elsif event.ausencia? %>
      <span class="tag is-rounded is-danger"><%= event.status&.titleize %></span>
    <% elsif event.por_confirmar? %>
      <span class="tag is-rounded is-warning"><%= event.status&.titleize %></span>
    <% else %>
      <span class="tag is-rounded is-danger"><%= event.status&.titleize %></span>
    <% end %>
    <span class="tag is-rounded">
      <%= event.user&.full_name&.titleize %>
    </span>
    <div class="snippet_title mt-2">
      <p>
        <span class="labell">Titulo: </span>
        <%= event.title&.titleize %>
      </p>
      <p>
        <span class="labell">Cliente: </span>
        <% if event.customer %>
          <%= event.customer.razon&.titleize %> (<%= event.customer&.tel_prefix %> <%= event.customer&.tel %>)
        <% else %>
          ?
        <% end %>
      </p>
      <p>
        <span class="labell">Folio: </span>
        <%= event.folio %>
      </p>
    </div>
  </div>
  <div class="snippet_icons">
    <span class="icon mr-2">
      <%= image_tag 'eye.svg', alt: 'view', class: 'invert', loading: 'lazy' %>
    </span>
  </div>
</div>
<%# modal %>
<div class="modal" id="event_<%= identifier %><%= event.id %>">
  <div class="modal-background"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title"><%= event.title&.titleize %></p>
      <button class="delete" aria-label="close"></button>
    </header>
    <section class="modal-card-body">
      <div class="columns is-multiline is-mobile">
        <div class="column is-12">
          <span class="icon material-icons-round mr-2">check_circle</span>
          <% if event.agendado? %>
            <span class="tag is-rounded"><%= event.status&.titleize %></span>
          <% elsif event.completado? %>
            <span class="tag is-rounded is-success"><%= event.status&.titleize %></span>
          <% elsif event.cancelado? %>
            <span class="tag is-rounded is-danger"><%= event.status&.titleize %></span>
          <% elsif event.ausencia? %>
            <span class="tag is-rounded is-danger"><%= event.status&.titleize %></span>
          <% elsif event.por_confirmar? %>
            <span class="tag is-rounded is-warning"><%= event.status&.titleize %></span>
          <% else %>
            <span class="tag is-rounded is-danger"><%= event.status&.titleize %></span>
          <% end %>
        </div>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              fingerprint
            </span>
            <div>
              <p class="labell">Folio: </p>
              <p><%= event.folio ? event.folio : "?" %></p>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">assignment_ind</span>
            <div>
              <p class="labell">Cliente</p>
              <p>
                <% if event.customer %>
                  <%= link_to customer_path(event.customer) do %>
                    <%= event.customer&.razon&.titleize %> (<%= event.customer&.tel_prefix %> <%= event.customer&.tel %>)
                  <% end %>
                <% else %>
                  ?
                <% end %>
              </p>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">assignment_ind</span>
            <div>
              <p class="labell">Agente</p>
              <p><%= event.user&.full_name&.titleize %></p>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">event</span>
            <div>
              <p class="labell">Dia</p>
              <p>
                <%= event.hora_inicio.strftime("%d/%m/%Y") %>
              </p>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">access_time_filled</span>
            <div>
              <p class="labell">Hora</p>
              <p><%= l(event.hora_inicio, format: :time) %> - <%= l(event.hora_final, format: :time) %></p>
            </div>
          </div>
        </div>
      </div>
      <% if event.body.present? %>
        <div class="mt-2" id="cem-body-wrap" hidden>
          <span class="icon material-icons-round mr-2">description</span>
          <p class="labell">Descripción</p>
          <p><%= event.body %></p>
        </div>
      <% end %>
      <% if event.motivo_cancelacion.present? %>
        <div class="flexx">
          <span class="icon material-icons-round mr-2 has-text-danger">
            dangerous
          </span>
          <div>
            <p class="labell has-text-danger">Motivo de cancelación: </p>
            <p><%= event.motivo_cancelacion %></p>
          </div>
        </div>
      <% end %>
    </section>
    <footer class="modal-card-foot">
      <div class="buttons">
        <% if event.agendado? and DateTime.current >= event.hora_inicio %>
          <%= link_to marcar_asistencia_events_path(id: event), data: { turbo_method: :post }, class: "button is-primary is-rounded" do %>
            <span class="icon mr-2">
              <%= image_tag 'verified-check-svgrepo-com.svg', alt: 'view', loading: 'lazy' %>
            </span>
            Asistencia
          <% end %>
          <%= link_to marcar_ausencia_events_path(id: event), data: { turbo_method: :post }, class: "button is-info is-rounded" do %>
            <span class="icon mr-2">
              <%= image_tag 'confounded-square-svgrepo-com.svg', alt: 'view', class: 'invert', loading: 'lazy' %>
            </span>
            Ausencia
          <% end %>
        <% end %>
        <% if event.por_confirmar? %>
          <%= link_to confirmar_events_path(id: event), data: { turbo_method: :post }, class: "button is-success is-rounded" do %>
            <span class="icon mr-2">
              <%= image_tag 'verified-check-svgrepo-com.svg', alt: 'view', loading: 'lazy' %>
            </span>
            Confirmar
          <% end %>
        <% end %>
        <%= link_to event_path(id: event), class: "button  is-rounded" do %>
          <span class="icon mr-2">
            <%= image_tag 'eye.svg', alt: 'view', class: 'invert', loading: 'lazy' %>
          </span>
          Detalles
        <% end %>
      </div>
    </footer>
  </div>
</div>