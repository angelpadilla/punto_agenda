<% content_for :title, "Detalle evento" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Detalle del evento</h2>
  <div class="actions">
    <%= link_to events_path, class: "button is-rounded" do %>
      <span class="icon mr-2">
        <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver 
    <% end %>
    <% if @event.agendado? and Time.current >= @event.hora_inicio %>
      <%= link_to marcar_asistencia_events_path(id: @event), data: { turbo_method: :post }, class: "button is-primary is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'verified-check-svgrepo-com.svg', alt: 'view', loading: 'lazy' %>
        </span>
        Asistencia
      <% end %>
      <%= link_to marcar_ausencia_events_path(id: @event), data: { turbo_method: :post }, class: "button is-info is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'confounded-square-svgrepo-com.svg', alt: 'view', class: 'invert', loading: 'lazy' %>
        </span>
        Ausencia
      <% end %>
    <% end %>
    <% if @event.por_confirmar? %>
      <%= link_to confirmar_events_path(id: @event), data: { turbo_method: :post }, class: "button is-success is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'verified-check-svgrepo-com.svg', alt: 'view', loading: 'lazy' %>
        </span>
        Confirmar
      <% end %>
    <% end %>
    <% if @event.agendado? %>
      <%= link_to edit_event_path(@event), class: "button is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'edit.svg', alt: 'editar', class: "invert" %>
        </span>
        Editar
      <% end %>
    <% end %>
    <% if @event.agendado? %>
      <div class="dropdown is-right is-hoverable">
        <div class="dropdown-trigger">
          <button class="button is-rounded" aria-haspopup="true">
            <span class="icon">
              <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
            </span>
            <span>Acciones</span>
          </button>
        </div>
        <div class="dropdown-menu" role="menu">
          <div class="dropdown-content">
            <a class="mtrigger dropdown-item" data-target="send_event_email">
              <span class="icon">
                <%= image_tag 'send.svg', alt: 'download', class: 'invert' %>
              </span>
              Email
            </a>
            <% if @corp.sms > 0 %>
              <a class="mtrigger dropdown-item" data-target="send_event_sms">
                <span class="icon">
                  <%= image_tag 'send.svg', alt: 'download', class: 'invert' %>
                </span>
                SMS
              </a>
            <% end %>
            <% if @corp.premium? or @corp.plus? %>
              <%# enviar por whatsapp %>
              <a class="mtrigger dropdown-item" data-target="send_event_whatsapp">
                <span class="icon">
                  <%= image_tag 'send.svg', alt: 'download', class: 'invert' %>
                </span>
                WhatsApp
              </a>
            <% end %>
            <% if @userr.admin? %>
              <%# enviar por whatsapp %>
              <a class="mtrigger dropdown-item has-text-danger" data-target="cancel_event">
                <span class="icon material-icons-round">delete</span>
                Cancelar evento
              </a>
              <% if @event.recurrente? %>
                <a class="mtrigger dropdown-item has-text-danger" data-target="cancel_event_recurrence">
                  <span class="icon material-icons-round">delete</span>
                  Cancelar grupo de recurrencia
                </a>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
<div class="box mt-4">
  <div class="box_header">
    <h2>
      <span class="icon mr-2">
        <%= image_tag 'calendar2.svg', class: "invert", alt: "Totales" %>
      </span>
      <span class="titlee"><%= @event.title %></span>
      <% if @event.agendado? %>
        <span class="tag is-rounded"><%= @event.status&.titleize %></span>
      <% elsif @event.completado? %>
        <span class="tag is-rounded is-success"><%= @event.status&.titleize %></span>
      <% elsif @event.cancelado? %>
        <span class="tag is-rounded is-danger"><%= @event.status&.titleize %></span>
      <% elsif @event.ausencia? %>
        <span class="tag is-rounded is-danger"><%= @event.status&.titleize %></span>
      <% elsif @event.por_confirmar? %>
        <span class="tag is-rounded is-warning"><%= @event.status&.titleize %></span>
      <% else %>
        <span class="tag is-rounded is-danger"><%= @event.status&.titleize %></span>
      <% end %>
    </h2>
  </div>
  <div class="box_content">
    <div class="columns is-multiline">
      <div class="column is-6">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">
            fingerprint
          </span>
          <div>
            <p class="labell">Folio: </p>
            <p><%= @event.folio ? @event.folio : "?" %></p>
          </div>
        </div>
      </div>
      <div class="column is-6">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">
            assignment_ind
          </span>
          <div>
            <p class="labell">Cliente: </p>
            <p>
              <% if @event.customer %>
                <%= link_to customer_path(@event.customer) do %>
                  <%= @event.customer&.razon&.titleize %> (<%= @event.customer&.tel_prefix %> <%= @event.customer&.tel %>)
                <% end %>
              <% else %>
                ?
              <% end %>
            </p>
          </div>
        </div>
      </div>
      <div class="column is-6">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">
            assignment_ind
          </span>
          <div>
            <p class="labell">Agente/colaborador: </p>
            <p><%= @event.user.full_name %></p>
          </div>
        </div>
      </div>
      <div class="column is-6">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">
            event
          </span>
          <div>
            <p class="labell">Dia y hora: </p>
            <p>
              <%= @event.hora_inicio.strftime("%d/%m/%Y") %> |
              <%= @event.hora_inicio.strftime("%I:%M %p") %> - <%= @event.hora_final.strftime("%I:%M %p") %>
            </p>
          </div>
        </div>
      </div>
      <div class="column is-6">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">
            access_time_filled
          </span>
          <div>
            <p class="labell">Fecha creacion: </p>
            <p><%= l(@event.created_at, format: :short) %></p>
          </div>
        </div>
      </div>
      <div class="column is-6">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">
            toll
          </span>
          <div>
            <p class="labell">Canal: </p>
            <p><%= @event.canal %></p>
          </div>
        </div>
      </div>
      <% if @event.recurrente? %>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              access_time_filled
            </span>
            <div>
              <p class="labell">Tipo: </p>
              <p>
                Recurrente
              </p>
            </div>
          </div>
        </div>
      <% end %>
      <% if @event.body.present? %>
        <div class="column is-12">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              description
            </span>
            <div>
              <p class="labell">Notas: </p>
              <p><%= @event.body %></p>
            </div>
          </div>
        </div>
      <% end %>
      <% if @event.motivo_cancelacion.present? %>
        <div class="column is-12">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              dangerous
            </span>
            <div>
              <p class="labell">Motivo de cancelación: </p>
              <p><%= @event.motivo_cancelacion %></p>
            </div>
          </div>
        </div>
      <% end %>
      <% if @event.orders.any? %>
        <div class="column is-12">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              receipt
            </span>
            <div>
              <p class="labell">Ventas relacionadas: </p>
              <ul>
                <% @event.orders.each do |order| %>
                  <li><%= link_to order_path(order) do %>
                      <%= order.folio %> - <%= order.tipo %>
                    <% end %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<% if @event.recurrente? %>
  <div class="box mt-4">
    <div class="box_header">
      <h2>
        <span class="icon mr-2">
          <%= image_tag 'calendar2.svg', class: "invert", alt: "Totales" %>
        </span>
        Informacion de recurrencia
      </h2>
    </div>
    <div class="box_content">
      <div class="columns is-multiline">
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              fingerprint
            </span>
            <div>
              <p class="labell">ID recurrencia: </p>
              <p><%= @event.recurrence_id %></p>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              dynamic_feed
            </span>
            <div>
              <p class="labell">Regla: </p>
              <p>
                <% if @event.recurrence_rule == "daily" %>
                  Diario
                <% elsif @event.recurrence_rule == "biweekly" %>
                  Quincenal
                <% elsif @event.recurrence_rule == "weekly" %>
                  Semanal
                <% elsif @event.recurrence_rule == "monthly" %>
                  Mensual
                <% else %>
                  <%= @event.recurrence_rule %>
                <% end %>
              </p>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              event
            </span>
            <div>
              <p class="labell">Cuando termina: </p>
              <p><%= l(@event.recurrence_ends_on, format: :long) %></p>
            </div>
          </div>
        </div>
        <div class="column is-6">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">
              123
            </span>
            <div>
              <p class="labell"># Numero: </p>
              <p><%= @event.recurrence_index %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
<%# modals %>
<div id="send_event_email" class="modal">
  <div class="modal-background"></div>
  <div class="modal-card">
    <%= form_with(url: send_email_events_path(folio: @event.folio), method: :post) do |form| %>
      <header class="modal-card-head">
        <p class="modal-card-title">Enviar detalles del evento por email</p>
        <div class="delete" aria-label="close"></div>
      </header>
      <section class="modal-card-body">
        <div class="columns is-multiline">
          <div class="field column is-12">
            <label class="label">Email</label>
            <%= form.email_field :email, value: @event.customer&.email.present? ? @event.customer.email : '', class: 'input is-rounded', required: true %>
          </div>
        </div>
      </section>
      <footer class="modal-card-foot">
        <%= form.submit "Enviar", class: "button is-primary is-rounded" %>
      </footer>
    <% end %>
  </div>
</div>
<% if @corp.premium? %>
  <div id="send_event_sms" class="modal">
    <div class="modal-background"></div>
    <div class="modal-card">
      <%= form_with(url: send_sms_events_path(folio: @event.folio), method: :post) do |form| %>
        <header class="modal-card-head">
          <p class="modal-card-title">Enviar detalles del evento por SMS</p>
          <div class="delete" aria-label="close"></div>
        </header>
        <section class="modal-card-body">
          <div class="columns is-multiline">
            <div class="field has-addons column is-12">
              <div class="control">
                <label class="label">* Teléfono</label>
                <%= form.select :tel_prefix, options_for_select(Customer::TelPrefixes.map { |k, v| ["#{v} (#{k})", k] }, @event.customer.tel_prefix),
                    {prompt: "Selecciona", required: true},
                    { "data-controller": "slimselect", class: "ss2"}
                    %>
              </div>
              <div class="control is-expanded">
                <label class="label is-ghost">Telefono</label>
                <%= form.text_field :tel, value: @event.customer&.tel, class: 'input is-rounded', required: true, pattern: '\d+' %>
              </div>
            </div>
          </div>
        </section>
        <footer class="modal-card-foot">
          <%= form.submit "Enviar", class: "button is-primary is-rounded" %>
        </footer>
      <% end %>
    </div>
  </div>
<% end %>
<% if @corp.premium? or @corp.plus? %>
  <div id="send_event_whatsapp" class="modal">
    <div class="modal-background"></div>
    <div class="modal-card">
      <%
      wa_tel = "#{@event.customer&.tel_prefix&.delete('+')}#{@event.customer&.tel}"
      wa_msg = "Tu evento programado: #{@event.title}\n" \
               "Dia: #{@event.hora_inicio.strftime('%d/%m/%Y')}\n" \
               "Hora: #{@event.hora_inicio.strftime('%I:%M %p')} - #{@event.hora_final.strftime('%I:%M %p')}\n\n" \
               "#{"Notas: #{@event.body}\n" if @event.body.present?}" \
               "Gracias por tu preferencia en #{@corp.name}!"
      wa_url = "https://wa.me/#{wa_tel}?text=#{CGI.escape(wa_msg)}"
    %>
      <header class="modal-card-head">
        <p class="modal-card-title">Enviar por WhatsApp</p>
        <div class="delete" aria-label="close"></div>
      </header>
      <section class="modal-card-body">
        <div class="mt-4 flexx">
          <span class="icon mr-2">
            <%= image_tag 'call-chat-rounded-svgrepo-com.svg', alt: 'download', class: 'invert' %>
          </span>
          <div>
            <p class="labell">Telefono</p>
            <p><%= @event.customer&.tel_prefix %> <%= @event.customer&.tel %></p>
          </div>
        </div>
        <div class="mt-4 flexx">
          <span class="icon mr-2">
            <%= image_tag 'chat-round-call-svgrepo-com.svg', alt: 'download', class: 'invert' %>
          </span>
          <div class="flexx-1">
            <p class="labell">Mensaje a enviar</p>
            <pre style="white-space: pre-wrap; font-size: 0.9rem;"><%= wa_msg %></pre>
          </div>
        </div>
      </section>
      <footer class="modal-card-foot">
        <%= link_to wa_url, target: "_blank", rel: "noopener", class: "button is-success is-rounded" do %>
          <span class="icon mr-2">
            <%= image_tag 'send.svg', alt: 'whatsapp' %>
          </span>
          Abrir WhatsApp
        <% end %>
      </footer>
    </div>
  </div>
<% end %>
<% if @userr.admin? %>
  <div id="cancel_event" class="modal">
    <div class="modal-background"></div>
    <div class="modal-card">
      <%= form_with(url: cancelar_events_path(id: @event), method: :post) do |form| %>
        <header class="modal-card-head">
          <p class="modal-card-title">Cancelar evento</p>
          <div class="delete" aria-label="close"></div>
        </header>
        <section class="modal-card-body">
          <div class="columns is-multiline">
            <div class="field column is-12">
              <label class="label">Motivo de cancelación</label>
              <%= form.text_area :motivo, class: 'textarea is-rounded', required: true, placeholder: "Escribe el motivo de la cancelación para registrar en el sistema y notificar al cliente" %>
            </div>
          </div>
        </section>
        <footer class="modal-card-foot">
          <%= form.submit "Cancelar", class: "button is-danger is-rounded" %>
        </footer>
      <% end %>
    </div>
  </div>
  <div id="cancel_event_recurrence" class="modal">
    <div class="modal-background"></div>
    <div class="modal-card">
      <%= form_with(url: cancelar_recurrence_events_path(recurrence_id: @event.recurrence_id), method: :post) do |form| %>
        <header class="modal-card-head">
          <p class="modal-card-title">Cancelar grupo de recurrencia</p>
          <div class="delete" aria-label="close"></div>
        </header>
        <section class="modal-card-body">
          <div class="columns is-multiline">
            <div class="field column is-12">
              <label class="label">Motivo de cancelación</label>
              <%= form.text_area :motivo, class: 'textarea is-rounded', required: true, placeholder: "Escribe el motivo de la cancelación para registrar en el sistema y notificar al cliente" %>
            </div>
          </div>
        </section>
        <footer class="modal-card-foot">
          <%= form.submit "Cancelar", class: "button is-danger is-rounded" %>
        </footer>
      <% end %>
    </div>
  </div>
<% end %>