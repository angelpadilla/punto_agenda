<%# https://air-datepicker.com/docs %>
<%= form_with(model: event, data: {
  controller: "form-event",
  form_event_business_hours_value: @corp.business_hours.to_json,
  form_event_current_slot_value: (params[:slot].presence || (event.hora_inicio && event.hora_final ? "#{event.hora_inicio.strftime('%H:%M')}|#{event.hora_final.strftime('%H:%M')}" : "")),
  form_event_availability_url_value: slot_agents_events_path(format: :json)
}) do |form| %>
  <% if event.errors.any? %>
    <div class="notification is-warning mt-4">
      <h2 class="subtitle"><%= pluralize(event.errors.count, "error", "errores") %> impidieron que este evento se guardara:</h2>
      <ul>
        <% event.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="box mt-4">
    <div class="columns is-multiline">
      <div class="field column is-6">
        <label class="label">*Día del evento</label>
        <div class="control">
          <% if params[:dia] %>
            <% _dia = Date.parse(params[:dia]) %>
            <%= form.hidden_field :dia, value: _dia.strftime("%Y-%m-%d"), data: { form_event_target: "diaHidden" } %>
            <input type="text"
                 readonly
                 placeholder="Selecciona un día"
                 value="<%= l(_dia, format: :default) %>"
                 class="input"
                 data-form-event-target="diaDisplay">
          <% else %>
            <%= form.hidden_field :dia,
                value: event.hora_inicio&.to_date,
                data: { form_event_target: "diaHidden" } %>
            <input type="text"
                 readonly
                 placeholder="Selecciona un día"
                 value="<%= event.hora_inicio ? l(event.hora_inicio.to_date, format: :default) : '' %>"
                 class="input <%= event.errors.include?(:dia) ? 'is-danger' : '' %>"
                 data-form-event-target="diaDisplay">
          <% end %>
          <% if event.errors.include?(:dia) %>
            <p class="help is-danger"><%= event.errors[:dia].first %></p>
          <% end %>
        </div>
      </div>
      <div class="field column is-6">
        <label class="label">*Horario</label>
        <div class="control">
          <div class="select is-fullwidth <%= event.errors.include?(:slot) ? 'is-danger' : '' %>">
            <%= form.select :slot,
                  options_for_select([], nil),
                  { prompt: "Selecciona primero el día" },
                  { required: true, data: { form_event_target: "slotSelect", action: "change->form-event#slotChanged" } } %>
          </div>
          <% if event.errors.include?(:slot) %>
            <p class="help is-danger"><%= event.errors[:slot].first %></p>
          <% end %>
        </div>
      </div>
      <%= t_field(form, :title, label: "Título", placeholder: "Ej.evento con Juan Pérez") %>
      <div class="column is-12">
        <label class="label">*Selecciona cliente</label>
        <div class="field has-addons">
          <div class="control is-expanded <%= event.errors.include?(:customer_id) ? 'select-is-danger' : '' %>">
            <%= form.select :customer_id, options_for_select(@corp.customers.default.map { |k| [k.razon&.titleize, k.id] }, event.customer_id),
                  {prompt: "Selecciona", required: field_required?(Event, :customer_id)},
                  { "data-controller": "slimselect", class: "ss2"}
                  %>
          </div>
          <div class="control">
            <div class="button mtrigger" data-target="new_customer">
              <span class="icon">
                <%= image_tag 'plus.svg', alt: 'new-customer', class: 'invert' %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="columns is-multiline">
      <div class="field column is-12">
        <label class="label">*Agente/Vendedor asignado al evento</label>
        <div class="control is-expanded <%= event.errors.include?(:user_id) ? 'select-is-danger' : '' %>">
          <% if current_user.colaborador? %>
            <%= form.select :user_id,
                  options_for_select([[current_user.full_name&.titleize, current_user.id]], current_user.id),
                  {},
                  { disabled: true, class: "input" } %>
            <%= form.hidden_field :user_id, value: current_user.id %>
          <% else %>
            <%= form.select :user_id, options_for_select(@corp.users.default.map { |k| [k.full_name&.titleize, k.id] }, event.user_id),
                  {prompt: "Selecciona", required: field_required?(Event, :user_id)},
                  { "data-controller": "slimselect", class: "ss2", data: { form_event_target: "userSelect" } }
                  %>
          <% end %>
        </div>
      </div>
    </div>
    <br>
    <p>* Campos obligatorios</p>
  </div>
  <div class="box expandable">
    <div class="box_header">
      <h2>
        <span class="icon mr-2">
          <%= image_tag 'documento.svg', alt: "sat", class: 'invert' %>
        </span>
        Extra (opcional)
      </h2>
      <span class="icon toggle_icon">
        <%= image_tag 'down.svg', alt: "toggle open", class: 'invert' %>
      </span>
    </div>
    <div class="box_content">
      <div class="columns is-multiline">
        <%= a_field(form, :body, label: "Descripción o notas") %>
      </div>
    </div>
  </div>
  <div class="field is-grouped is-justify-content-space-between mt-5">
    <div class="control">
      <%= link_to "Cancelar", monthly_events_path, class: "button is-rounded" %>
    </div>
    <div class="control">
      <%= form.submit "Guardar", class: "button is-rounded is-primary" %>
    </div>
  </div>
<% end %>
<%# modals %>
<div id="new_customer" class="modal">
  <div class="modal-background"></div>
  <div class="modal-content">
    <div class="box">
      <h3 class="title is-4">Crear nuevo cliente</h3>
      <div id="customer-form-errors"></div>
      <%= form_with(model: Customer.new, url: create_from_event_customers_path) do |f| %>
        <div class="columns is-multiline">
          <%= t_field(f, :razon, placeholder: "Nombre del cliente") %>
          <%= e_field(f, :email, placeholder: "Correo electrónico del cliente") %>
          <div class="field has-addons column is-12">
            <div class="control">
              <label class="label">* Teléfono</label>
              <%= f.select :tel_prefix, options_for_select(Customer::TelPrefixes.map { |k, v| ["#{v} (#{k})", k] }),
                    {prompt: "Selecciona", required: field_required?(Customer, :tel_prefix)},
                    { "data-controller": "slimselect", class: "ss2"}
                    %>
            </div>
            <%= t_field(f, :tel, label: "Teléfono", placeholder: "Ej. 1234567890", clas: "control is-expanded", label_ghost: true) %>
          </div>
        </div>
        <%= f.submit "Guardar", class: "button is-primary is-fullwidth is-rounded" %>
      <% end %>
    </div>
  </div>
  <button class="modal-close is-large" aria-label="close"></button>
</div>