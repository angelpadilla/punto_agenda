<%# https://air-datepicker.com/docs %>
<%= form_with(model: event, data: {
  controller: "form-event",
  form_event_business_hours_value: @corp.business_hours.to_json,
  form_event_slot_duration_value: @corp.slot_duration || 15
}) do |form| %>
  <% if event.errors.any? %>
    <div class="notification is-warning mt-4">
      <h2 class="subtitle"><%= pluralize(event.errors.count, "error", "errores") %> impidieron que esta razon se guardara:</h2>
      <ul>
        <% event.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="box mt-4">
    <div class="columns is-multiline">
      <div class="field column is-12">
        <label class="label">Cliente</label>
        <div class="control is-expanded <%= event.errors.include?(:customer_id) ? 'select-is-danger' : '' %>">
          <%= form.select :customer_id, options_for_select(Customer.default.map { |k| ["#{k.razon&.titleize} #{k.tel}", k.id] }, event.customer_id),
                {prompt: "Selecciona", required: field_required?(Event, :customer_id)},
                { "data-controller": "slimselect", class: "ss2"}
                %>
        </div>
      </div>
      <%= t_field(form, :title, label: "Título", placeholder: "Ej.evento con Juan Pérez") %>
    </div>
    <div class="columns is-multiline">
      <%# Arreglo de horas: saltos de slot_duration configurado %>
      <% step = @corp.slot_duration || 15 %>
      <% horas_opciones = (0...1440).step(step).map { |total_min| Time.new(2000, 1, 1, total_min / 60, total_min % 60).strftime("%I:%M %p") } %>
      <div class="field column is-4">
        <label class="label">Día del evento</label>
        <div class="control">
          <% if params[:dia] %>
            <%= form.hidden_field :dia, value: params[:dia], data: { form_event_target: "diaHidden" } %>
            <input type="text"
                 readonly
                 placeholder="Selecciona un día"
                 value="<%= l(Date.parse(params[:dia]), format: :default) %>"
                 class="input"
                 data-form-event-target="diaDisplay">
          <% else %>
            <%# Hidden field that holds the YYYY-MM-DD value sent to the controller %>
            <%= form.hidden_field :dia,
                value: event.hora_inicio&.to_date,
                data: { form_event_target: "diaHidden" } %>
            <%# Visible display input that AirDatepicker attaches to %>
            <input type="text"
                 readonly
                 placeholder="Selecciona un día"
                 value="<%= event.hora_inicio ? l(event.hora_inicio.to_date, format: :default) : '' %>"
                 class="input <%= event.errors.include?(:dia) ? 'is-danger' : '' %>"
                 data-form-event-target="diaDisplay">
          <% end %>
        </div>
      </div>
      <div class="field column is-4">
        <label class="label">Hora de inicio</label>
        <div class="control">
          <div class="select is-fullwidth <%= event.errors.include?(:inicio_hora) ? 'is-danger' : '' %>">
            <%= form.select :inicio_hora,
                  options_for_select(horas_opciones, event.hora_inicio&.strftime('%I:%M %p')),
                  { prompt: "Selecciona hora" },
                  { required: true, data: { form_event_target: "inicioHora", action: "change->form-event#inicioChanged" } } %>
          </div>
        </div>
      </div>
      <div class="field column is-4">
        <label class="label">Hora final</label>
        <div class="control">
          <div class="select is-fullwidth <%= event.errors.include?(:final_hora) ? 'is-danger' : '' %>">
            <%= form.select :final_hora,
                  options_for_select(horas_opciones, event.hora_final&.strftime('%I:%M %p')),
                  { prompt: "Selecciona hora" },
                  { required: true, data: { form_event_target: "finalHora" } } %>
          </div>
        </div>
      </div>
      <div class="field column is-12">
        <label class="label">Agente/Vendedor asignado al evento</label>
        <div class="control is-expanded <%= event.errors.include?(:user_id) ? 'select-is-danger' : '' %>">
          <%= form.select :user_id, options_for_select(@corp.users.default.map { |k| [k.full_name&.titleize, k.id] }, event.user_id),
                {prompt: "Selecciona", required: field_required?(Event, :user_id)},
                { "data-controller": "slimselect", class: "ss2"}
                %>
        </div>
      </div>
    </div>
  </div>
  <div class="box expandable">
    <div class="box_header">
      <h2>
        <span class="icon mr-2">
          <%= image_tag 'documento.svg', alt: "sat", class: 'invert' %>
        </span>
        Extra (opcional)
      </h2>
      <span class="icon toggle_icon">
        <%= image_tag 'down.svg', alt: "toggle open", class: 'invert' %>
      </span>
    </div>
    <div class="box_content">
      <div class="columns is-multiline">
        <%= a_field(form, :body, label: "Descripción o notas") %>
      </div>
    </div>
  </div>
  <div class="field is-grouped is-justify-content-space-between mt-5">
    <div class="control">
      <%= link_to "Cancelar", monthly_events_path, class: "button is-rounded" %>
    </div>
    <div class="control">
      <%= form.submit "Guardar", class: "button is-rounded is-primary" %>
    </div>
  </div>
<% end %>