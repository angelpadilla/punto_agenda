<%= form_with(model: brand) do |form| %>
  <% if brand.errors.any? %>
    <div class="notification is-warning">
      <h2 class="subtitle"><%= pluralize(brand.errors.count, "error", "errores") %> impidieron que esta razon se guardara:</h2>
      <ul>
        <% brand.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class='box mt-4'>
    <h2 class='subtitle'>Datos basicos</h2>
    <div class='columns is-multiline'>
      <%= t_field(form, :name, label: "Nombre de la marca", placeholder: "Ej. Coca-Cola") %>
    </div>
  </div>
  <div class="field is-grouped is-justify-content-space-between mt-5">
    <div class="control">
      <%= link_to "Cancelar", brands_path, class: "button is-rounded" %>
    </div>
    <div class="control">
      <%= form.submit "Guardar", class: "button is-rounded is-primary" %>
    </div>
  </div>
<% end %>
<br>
<br>