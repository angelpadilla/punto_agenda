<% if @brand.errors.any? %>
  <div class="notification is-danger">
    <h2 class="subtitle"><%= pluralize(@brand.errors.count, "error", "errores") %> impidieron que esta marca se guardara:</h2>
    <ul>
      <% @brand.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>