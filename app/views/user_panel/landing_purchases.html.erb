<% content_for :title, "Compras, gastos y proovedores" %>
<div class="columns is-multiline">
  <div class="column is-6">
    <%= link_to new_purchase_path do %>
      <div class="linkk">
        <%= image_tag 'plus.svg', alt: 'cargos', class: 'invert' %>
        Nueva compra
      </div>
    <% end %>
  </div>
  <div class="column is-6">
    <%= link_to new_gasto_purchases_path do %>
      <div class="linkk">
        <%= image_tag 'plus.svg', alt: 'cargos', class: 'invert' %>
        Nuevo gasto
      </div>
    <% end %>
  </div>
  <div class="column is-12">
    <%= link_to purchases_path do %>
      <div class="linkk">
        <%= image_tag 'bill-list-svgrepo-com.svg', alt: 'cargos', class: 'invert' %>
        Compras y gastos
      </div>
    <% end %>
  </div>
  <div class="column is-12">
    <%= link_to providers_path do %>
      <div class="linkk">
        <%= image_tag 'clientes.svg', alt: 'cargos', class: 'invert' %>
        Proveedores
      </div>
    <% end %>
  </div>
</div>
