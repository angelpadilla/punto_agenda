<tr>
  <td>
    <%= link_to user_path(user), class: "mr-2" do %>
      <span class="icon">
        <%= image_tag 'eye.svg', alt: 'view', class: 'invert' %>
      </span>
    <% end %>
  </td>
  <td class="flexx vertical-center gap-2">
    <div class="image is-48x48 avatar">
      <%= image_tag "https://api.dicebear.com/10.x/micah/svg?backgroundColor=bdf5df&mouthVariant=laughing,pucker,smile,smirk,surprised&seed=#{user.id}", alt: "avatar", class: "rounded" %>
    </div>
    <div>
      <p class="contentt">
        <%= user.full_name %>
      </p>
      <p class="labell">
        <%= user.email %>
      </p>
    </div>
  </td>
  <% if @corp.calendar %>
    <td><%= user.events.count %></td>
  <% end %>
  <td><%= user.sales.count %></td>
  <td>
    <span class="tag is-rounded"><%= user.tipo %></span>
  </td>
  <td>
    <% if user.active %>
      <span class="tag is-rounded is-success">Activo</span>
    <% else %>
      <span class="tag is-rounded is-danger">Inactivo</span>
    <% end %>
  </td>
</tr>