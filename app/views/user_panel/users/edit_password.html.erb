<% content_for :title, "Editar contraseña" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Edición de contraseña</h2>
  <div class="actions">
    <%= link_to users_path, class: "button is-rounded mr-2" do %>
      <span class="icon mr-2">
        <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
      </span>
      Listado de usuarios
    <% end %>
    <%= link_to user_path(@user), class: "button is-rounded" do %>
      <span class="icon mr-2">
        <%= image_tag 'eye.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver a usuario
    <% end %>
  </div>
</div>
<%= form_with(model: @user, url: update_password_user_path(@user), method: :post) do |form| %>
  <% if @user.errors.any? %>
    <div class="notification is-warning mt-4">
      <h2 class="subtitle"><%= pluralize(@user.errors.count, "error", "errores") %> impidieron que este usuario se guardara:</h2>
      <ul>
        <% @user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="box mt-4">
    <div class="box_header">
      <h2>
        <span class="icon mr-2">
          <%= image_tag 'key-svgrepo-com.svg', alt: "Cambiar contraseña", class: 'invert' %>
        </span>
        Cambiar contraseña
      </h2>
    </div>
    <div class="box_content">
      <div class="columns is-multiline is-mobile">
        <%= p_field(form, :password, label: "Contraseña", placeholder: "********", clas: "field column is-6", required: true) %>
        <%= p_field(form, :password_confirmation, label: "Confirmar contraseña", placeholder: "********", clas: "field column is-6", required: true ) %>
      </div>
    </div>
  </div>
  <div class="field is-grouped is-justify-content-space-between mt-5">
    <div class="control">
      <%= form.submit "Guardar", class: "button is-rounded is-primary" %>
    </div>
  </div>
<% end %>