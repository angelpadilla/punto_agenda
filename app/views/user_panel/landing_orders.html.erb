<% content_for :title, "Ventas" %>
<div class="columns is-multiline">
  <div class="column is-12">
    <%= link_to new_order_path do %>
      <div class="linkk">
        <%= image_tag 'plus.svg', alt: 'cargos', class: 'invert' %>
        Nueva venta
      </div>
    <% end %>
  </div>
  <div class="column is-12">
    <%= link_to orders_path do %>
      <div class="linkk">
        <%= image_tag 'layers.svg', alt: 'cargos', class: 'invert' %>
        Ventas
      </div>
    <% end %>
  </div>
  <% if @userr.admin? %>
    <div class="column is-6">
      <a class="mtrigger" data-target="calc_comision">
        <div class="linkk">
          <%= image_tag 'circle-bottom-up-svgrepo-com.svg', alt: 'cargos', class: 'invert' %>
          Calcular comision de ventas
        </div>
      </a>
    </div>
  <% end %>
</div>
<% if @userr.admin? %>
  <%# modal calcular comision %>
  <div id="calc_comision" class="modal">
    <div class="modal-background"></div>
    <div class="modal-content">
      <div class="box">
        <p>Selecciona el rango de fechas para el reporte ...</p>
        <br>
        <%= form_with url: reporte_comisiones_orders_path, method: :get do |form| %>
          <div class="columns is-multiline">
            <div class="field column is-6">
              <label class="label">Fecha inicial</label>
              <%= form.date_field :fecha_inicial, class: "input is-rounded", required: true %>
            </div>
            <div class="field column is-6">
              <label class="label">Fecha final</label>
              <%= form.date_field :fecha_final, class: "input is-rounded", required: true %>
            </div>
            <div class="field column is-12">
              <label class="label">Vendedor</label>
              <div class="control">
                <div class="select is-rounded is-fullwidth">
                  <%= form.select :seller_id,
                        options_for_select(@corp.users.pluck(:full_name, :id)), {prompt: 'Selecciona un vendedor...', required: true}, { class: '' } %>
                </div>
              </div>
            </div>
          </div>
          <%= form.submit "Consultar", class: "button is-primary is-fullwidth is-rounded" %>
        <% end %>
      </div>
    </div>
    <button class="modal-close is-large" aria-label="close"></button>
  </div>
<% end %>