<%= form_with(model: customer, data: { controller: "form-customer" }) do |form| %>
  <% if customer.errors.any? %>
    <div class="notification is-warning">
      <h2 class="subtitle"><%= pluralize(customer.errors.count, "error", "errores") %> impidieron que este cliente se guardara:</h2>
      <ul>
        <% customer.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="box mt-4">
    <h2>
      <span class="icon mr-2">
        <%= image_tag 'user_data.svg', alt: "Limite de credito", class: 'invert' %>
      </span>
      Datos principales
    </h2>
    <hr>
    <div class="columns is-multiline">
      <div class="field column is-12">
        <label class="checkbox">
          <%= form.check_box :active, class: '' %>
          Activo
        </label>
      </div>
      <%= t_field(form, :razon, label: "Nombre/Razon social", placeholder: "Ej. Juan Pérez") %>
      <%= e_field(form, :email, label: "Email", placeholder: "Ej. juan.perez@example.com", clas: "field column is-6") %>
      <div class="field has-addons column is-6">
        <div class="control <%= customer.errors.include?(:tel_prefix) ? 'select-is-danger' : '' %>">
          <label class="label">* Teléfono</label>
          <%= form.select :tel_prefix, options_for_select(Customer::TelPrefixes.map { |k, v| ["#{v} (#{k})", k] }, customer.tel_prefix),
                    {prompt: "Selecciona", required: field_required?(Customer, :tel_prefix)},
                    { "data-controller": "slimselect", class: "ss2"}
                    %>
        </div>
        <%= t_field(form, :tel, label: "Teléfono", placeholder: "Ej. 1234567890", clas: "control is-expanded", label_ghost: true) %>
      </div>
      <%= a_field(form, :notas, label: "Notas", placeholder: "Ej. Información adicional sobre el cliente") %>
    </div>
    <% if false %>
      <%# vista de customer :docs %>
      <div class="docs_grid">
        <% if customer.docs.attached? %>
          <% customer.docs.each_with_index do |doc, index| %>
            <div class="doc_tile">
              <span class="icon">
                <%= image_tag 'documento.svg', alt: "Documento #{index + 1}", class: 'invert' %>
              </span>
              <div class="doc_tile_info">
                <div class="doc_tile__title">
                  <%= doc.filename.to_s %>
                </div>
                <div class="doc_tile__meta">
                  <%= number_to_human_size(doc.byte_size) %>
                </div>
              </div>
              <%# icon to delete doc %>
              <% if action_name == 'edit' %>
                <span class="doc_tile__action">
                  <%= link_to delete_doc_customer_path(customer, doc.id), method: :delete, data: { confirm: "¿Estás seguro de que deseas eliminar este documento?" }, class: "" do %>
                    <span class="icon">
                      <%= image_tag 'trash.svg', alt: "Documento #{index + 1}", class: 'invert' %>
                    </span>
                  <% end %>
                </span>
              <% else %>
                <span class="doc_tile__action" data-action="click->form-customer#deleteDoc" data-doc-id="<%= doc.id %>">
                  <span class="icon">
                    <%= image_tag 'trash.svg', alt: "Documento #{index + 1}", class: 'invert' %>
                  </span>
                </span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
      <div class="doc_input">
        <%= form.file_field :docs, class: "doc_file_field", accept: ".jpg,.jpeg,.png,.pdf, .doc, .docx", multiple: true, data: { action: "change->form-customer#previewDocs" } %>
        <span class="doc_action">Seleccionar archivos</span>
      </div>
    <% end %>
    <p>* Campos obligatorios</p>
  </div>
  <% if customer.interno? %>
    <div class="box expandable">
      <div class="box_header">
        <h2>
          <span class="icon mr-2">
            <%= image_tag 'sat2.svg', alt: "sat" %>
          </span>
          Datos fiscales (opcional)
        </h2>
        <span class="icon toggle_icon">
          <%= image_tag 'down.svg', alt: "toggle open", class: 'invert' %>
        </span>
      </div>
      <div class="box_content">
        <div class="columns is-multiline">
          <%= s_field(form, :regimen, options: Corp::RegimenFiscales, label: "Regimen fiscal", clas: "field column is-12") %>
          <%= t_field(form, :rfc, label: "RFC", placeholder: "Ej. ACME123456789", clas: "field column is-6") %>
          <%= t_field(form, :curp, label: "CURP", placeholder: "Ej. ACME123456789", clas: "field column is-6") %>
          <%= s_field(form, :estado, options: Corp::States, label: "Estado", clas: "field column is-6") %>
          <%= t_field(form, :ciudad, label: "Ciudad", placeholder: "Ej. Ciudad", clas: "field column is-6") %>
        </div>
        <div class="columns is-multiline is-mobile">
          <%= t_field(form, :cp, label: "Código Postal", placeholder: "Ej. 12345", clas: "field column is-3-desktop is-3-tablet is-3-mobile") %>
          <%= t_field(form, :colonia, label: "Colonia", placeholder: "Ej. Colonia", clas: "field column is-3-desktop is-3-tablet is-3-mobile") %>
          <%= t_field(form, :localidad, label: "Localidad", placeholder: "Ej. Localidad", clas: "field column is-6-desktop is-6-tablet is-6-mobile") %>
          <%= t_field(form, :calle, label: "Calle", placeholder: "Ej. Calle", clas: "field column is-8-desktop is-6-tablet is-6-mobile") %>
          <%= t_field(form, :num_exterior, label: "# Exterior", placeholder: "Ej. 123", clas: "field column is-2-desktop is-3-tablet is-3-mobile") %>
          <%= t_field(form, :num_interior, label: "# Interior", placeholder: "Ej. ABC", clas: "field column is-2-desktop is-3-tablet is-3-mobile") %>
        </div>
      </div>
    </div>
  <% end %>
  <div class="field is-grouped is-justify-content-space-between mt-5">
    <div class="control">
      <%= link_to "Cancelar", customers_path, class: "button is-rounded" %>
    </div>
    <div class="control">
      <%= form.submit "Guardar", class: "button is-rounded is-primary" %>
    </div>
  </div>
<% end %>