<% content_for :title, "Detalle del Cliente" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Detalle del Cliente</h2>
  <div class="actions">
    <%= link_to customers_path, class: "button is-rounded mr-2" do %>
      <span class="icon mr-2">
        <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver a listado 
    <% end %>
    <% if @customer.interno? %>
      <%= link_to edit_customer_path(@customer), class: "button is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'edit.svg', alt: 'editar', class: "invert" %>
        </span>
        Editar
      <% end %>
    <% end %>
    <div class="dropdown is-right is-hoverable">
      <div class="dropdown-trigger">
        <button class="button is-rounded" aria-haspopup="true">
          <span class="icon">
            <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
          </span>
          <span>Acciones</span>
        </button>
      </div>
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <%= link_to "#", data: {turbo_method: :post, turbo_confirm: "¿Estás seguro de que deseas enviar la contraseña por correo?"}, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'key-svgrepo-com.svg', alt: 'cancel', class: 'invert' %>
            </span>
            Enviar contraseña a correo
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<div class='box mt-4'>
  <div class='columns is-multiline'>
    <div class="column is-2 is-hidden-touch">
      <%= image_tag 'user.svg', alt: 'item', class: 'invert', loading: 'lazy' %>
    </div>
    <div class="column is-10">
      <div class="tags">
        <% if @customer.active %>
          <span class="tag is-success is-rounded">Activo</span>
        <% else %>
          <span class="tag is-danger is-rounded">Inactivo</span>
        <% end %>
      </div>
      <h3 class="titlee2 mb-4"><%= @customer.razon %></h3>
      <div class="columns is-multiline is-mobile">
        <div class="column is-12-mobile is-6-tablet is-6-desktop">
          <div class="labell">Email</div>
          <p class="contentt"><%= @customer.email %></p>
        </div>
        <div class="column is-12-mobile is-6-tablet is-6-desktop">
          <div class="labell">Teléfono</div>
          <p class="contentt"><%= @customer.tel_prefix %> <%= @customer.tel %></p>
        </div>
        <div class="column is-12-mobile is-6-tablet is-6-desktop">
          <div class="labell">Canal</div>
          <p class="contentt"><%= @customer.canal&.humanize %></p>
        </div>
        <div class="column is-12">
          <div class="labell">Notas</div>
          <p class=""><%= @customer.notas %></p>
        </div>
      </div>
      <div class="columns is-multiline is-mobile">
        <div class="column is-12-mobile is-6-tablet is-6-desktop">
          <div class="labell">Fecha de creación</div>
          <p class=""><%= l(@customer.created_at, format: :long) %></p>
        </div>
        <div class="column is-12-mobile is-6-tablet is-6-desktop">
          <div class="labell">Fecha de última actualización</div>
          <p class=""><%= l(@customer.updated_at, format: :long) %></p>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="box expandable <%= @customer.facturacion? %>">
  <div class="box_header">
    <h2>
      <span class="icon mr-2">
        <%= image_tag 'sat2.svg', alt: "Datos fiscales" %>
      </span>
      Datos fiscales 
    </h2>
    <span class="icon toggle_icon">
      <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
    </span>
  </div>
  <div class="box_content">
    <div class="columns is-multiline is-mobile">
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <div class="labell">Regimen fiscal</div>
        <p class="contentt"><%= @customer.regimen %></p>
      </div>
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <div class="labell">RFC</div>
        <p class="contentt"><%= @customer.rfc %></p>
      </div>
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <div class="labell">CURP</div>
        <p class="contentt"><%= @customer.curp %></p>
      </div>
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <div class="labell">Estado</div>
        <p class="contentt"><%= @customer.estado %></p>
      </div>
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <div class="labell">Ciudad</div>
        <p class="contentt"><%= @customer.ciudad %></p>
      </div>
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <div class="labell">Código Postal</div>
        <p class="contentt"><%= @customer.cp %></p>
      </div>
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <div class="labell">Colonia</div>
        <p class="contentt"><%= @customer.colonia %></p>
      </div>
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <div class="labell">Localidad</div>
        <p class="contentt"><%= @customer.localidad %></p>
      </div>
    </div>
    <div class="columns is-multiline is-mobile">
      <div class="column is-12-mobile is-6-tablet is-8-desktop">
        <div class="labell">Calle</div>
        <p class="contentt"><%= @customer.calle %></p>
      </div>
      <div class="column is-6-mobile is-3-tablet is-2-desktop">
        <div class="labell"># Exterior</div>
        <p class="contentt"><%= @customer.num_ext %></p>
      </div>
      <div class="column is-6-mobile is-3-tablet is-2-desktop">
        <div class="labell"># Interior</div>
        <p class="contentt"><%= @customer.num_int %></p>
      </div>
    </div>
  </div>
</div>