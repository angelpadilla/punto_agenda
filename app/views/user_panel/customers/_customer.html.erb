<div class="item_box">
  <div class="table_item">
    <div class="item_image">
      <% odd_even = rand(1..2) %>
      <% if odd_even.even? %>
        <%= image_tag 'customer1.png', alt: 'item', class: 'rounded', loading: 'lazy' %>
      <% else %>
        <%= image_tag 'customer2.png', alt: 'item', class: 'rounded', loading: 'lazy' %>
      <% end %>
    </div>
    <div class="item_info flexx-3">
      <div>
        <% unless customer.active %>
          <span class="tag is-danger is-light is-rounded">Inactivo</span>
        <% end %>
      </div>
      <h3 class="titlee2"><%= customer.razon %></h3>
      <!-- info -->
      <div class="columns is-mobile is-multiline mt-2">
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <div class="labell">Email</div>
          <p class="contentt"><%= customer.email %></p>
        </div>
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <div class="labell">Teléfono</div>
          <p class="contentt"><%= customer.tel_prefix %> <%= customer.tel %></p>
        </div>
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <div class="labell">RFC</div>
          <p class="contentt"><%= customer.rfc %></p>
        </div>
        <div class="column is-12-mobile is-6-tablet is-4-desktop">
          <div class="labell">Canal</div>
          <p class="contentt"><%= customer.canal&.humanize %></p>
        </div>
      </div>
      <% if customer.notas.present? %>
        <div class="columns is-mobile is-multiline mt-2">
          <div class="column is-12-mobile is-6-tablet is-4-desktop">
            <div class="labell">Notas</div>
            <p class=""><%= customer.notas %></p>
          </div>
        </div>
      <% end %>
    </div>
    <div class="item_actions">
      <div class="dropdown is-right is-hoverable">
        <div class="dropdown-trigger">
          <button aria-haspopup="true">
            <span class="icon r90">
              <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
            </span>
          </button>
        </div>
        <div class="dropdown-menu" role="menu">
          <div class="dropdown-content">
            <%= link_to edit_customer_path(customer), class: "dropdown-item" do  %>
              <span class="icon mr-2">
                <%= image_tag 'edit.svg', alt: 'edit', class: 'invert' %>
              </span>
              Editar
            <% end %>
            <%= link_to customer_path(customer), data: { turbo_confirm: "¿Estás seguro?", turbo_method: :delete }, class: "dropdown-item" do  %>
              <span class="icon mr-2">
                <%= image_tag 'trash.svg', alt: 'delete', class: 'invert' %>
              </span>
              Eliminar
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="item_buttons mt-6">
    <%= link_to customer_path(customer), class: "button is-rounded is-fullwidth" do  %>
      Ver detalles
    <% end %>
    <%= link_to new_event_path(customer_id: customer.id), class: "button is-rounded is-primary has_tooltip" do  %>
      <span class="icon reset">
        <%= image_tag 'calendar_plus.svg', alt: 'clear', class: '' %>
      </span>
      <div class="tooltip up">Agenda evento</div>
    <% end %>
  </div>
</div>