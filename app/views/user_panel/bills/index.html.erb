<% content_for :title, "Facturación" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Facturación</h2>
  <div class="actions">
    <div class="dropdown is-right is-hoverable">
      <div class="dropdown-trigger">
        <button class="button is-rounded" aria-haspopup="true">
          <span class="icon">
            <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
          </span>
          <span>Acciones</span>
        </button>
      </div>
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <%= link_to new_user_path, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'download.svg', alt: 'download', class: 'invert' %>
            </span>
            Exportar CSV
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<hr>
<%= search_form_for @q, url: bills_path do |f| %>
  <div class="columns is-multiline">
    <div class="column is-4">
      <%= f.search_field :folio_or_id_eq, class: 'is-rounded search_input', placeholder: 'Folio' %>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :tipo_eq, options_for_select(Bill.tipos.keys.map { |k| [k.humanize, k] }, (params[:q] and !params[:q][:tipo_eq].blank?) ? params[:q][:tipo_eq] : nil), {prompt: "Tipo"}, {class: ""} %>
      </div>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :status_pago_eq, options_for_select(Bill.status_pagos.keys.map { |k| [k.humanize, k] }, (params[:q] and !params[:q][:status_pago_eq].blank?) ? params[:q][:status_pago_eq] : nil), {prompt: "Estatus pago"}, {class: ""} %>
      </div>
    </div>
    <div class="column is-3">
      <div class="buttons">
        <%= f.submit 'Buscar', class: "button is-rounded is-primary" %>
        <%= link_to bills_path, class: "button is-rounded has_tooltip" do %>
          <span class="icon reset">
            <%= image_tag 'trash.svg', alt: 'clear', class: 'invert' %>
          </span>
          <div class="tooltip down">Limpiar busqueda</div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<table class="table is-fullwidth is-hoverable mt-4">
  <thead>
    <tr>
      <th></th>
      <th><%= sort_link(@q, :created_at, 'Fecha') %></th>
      <th><%= sort_link(@q, :folio, 'Folio') %></th>
      <th><%= sort_link(@q, :status_pago, 'Status Pago') %></th>
      <th><%= sort_link(@q, :tipo, 'Tipo') %></th>
      <th>Total</th>
    </tr>
  </thead>
  <tbody>
    <%= render @bills %>
  </tbody>
</table>
<% if @pagy.pages > 1 %>
  <br>
  <%== @pagy.series_nav(:bulma) %>
  <br>
<% end %>
<br>
<br>