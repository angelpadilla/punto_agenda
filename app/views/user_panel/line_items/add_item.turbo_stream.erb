<%= turbo_stream.update "ticket_resumen", partial: "user_panel/orders/ticket_resumen", locals: { order: @order, source: params[:source] } %>
<% if @show_cart_button && @order.line_items.count > 0 %>
  <%= turbo_stream.append "ticket_resumen", partial: "user_panel/orders/cart_button", locals: { order: @order } %>
<% end %>
<%# 2. Cerrar el modal %>
<%= turbo_stream.update "close_modal_#{@item.id}" do %>
  <script>
    (function() {
      const modal = document.getElementById("item_<%= @item.id %>");
      if (modal) {
        modal.classList.remove("is-active");

        // Limpiar formulario modal
        modal.querySelector("form").reset();

      }
    })();
  </script>
<% end %>
