<% content_for :title, "Editar proveedor" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Edición de proveedor</h2>
  <div class="actions">
    <%= link_to providers_path, class: "button is-rounded mr-2" do %>
      <span class="icon mr-2">
        <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver a listado
    <% end %>
    <%= link_to provider_path(@provider), class: "button is-rounded" do %>
      <span class="icon mr-2">
        <%= image_tag 'eye.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver a proveedor
    <% end %>
  </div>
</div>
<%= render 'form', provider: @provider %>
