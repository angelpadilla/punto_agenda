<%= form_with(model: provider) do |form| %>
  <% if provider.errors.any? %>
    <div class="notification is-warning">
      <h2 class="subtitle"><%= pluralize(provider.errors.count, "error", "errores") %> impidieron que este proveedor se guardara:</h2>
      <ul>
        <% provider.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="box mt-4">
    <h2>
      <span class="icon mr-2">
        <%= image_tag 'user_data.svg', alt: "Limite de credito", class: 'invert' %>
      </span>
      Datos principales
    </h2>
    <hr>
    <div class="columns is-multiline">
      <%= t_field(form, :razon, label: "Nombre/Razon social", placeholder: "Ej. Juan Pérez") %>
      <%= e_field(form, :email, label: "Email", placeholder: "Ej. juan.perez@example.com", clas: "field column is-6") %>
      <%= n_field(form, :tel, label: "Telefono", placeholder: "Ej. 555-123-4567", clas: "field column is-6") %>
      <%= a_field(form, :notas, label: "Notas", placeholder: "Ej. Información adicional sobre el proveedor") %>
    </div>
    <p>* Campos obligatorios</p>
  </div>
  <div class="box expandable">
    <div class="box_header">
      <h2>
        <span class="icon mr-2">
          <%= image_tag 'sat2.svg', alt: "Datos fiscales" %>
        </span>
        Datos fiscales (opcional)
      </h2>
      <span class="icon toggle_icon">
        <%= image_tag 'down.svg', alt: "Datos fiscales", class: 'invert' %>
      </span>
    </div>
    <div class="box_content">
      <div class="columns is-multiline">
        <%= s_field(form, :regimen, options: Corp::RegimenFiscales, label: "Regimen fiscal", clas: "field column is-12") %>
        <%= t_field(form, :rfc, label: "RFC", placeholder: "Ej. ACME123456789", clas: "field column is-6") %>
        <%= s_field(form, :estado, options: Corp::States, label: "Estado", clas: "field column is-6") %>
        <%= t_field(form, :ciudad, label: "Ciudad", placeholder: "Ej. Ciudad", clas: "field column is-6") %>
      </div>
      <div class="columns is-multiline is-mobile">
        <%= t_field(form, :cp, label: "Código Postal", placeholder: "Ej. 12345", clas: "field column is-3-desktop is-3-tablet is-3-mobile") %>
        <%= t_field(form, :colonia, label: "Colonia", placeholder: "Ej. Colonia", clas: "field column is-3-desktop is-3-tablet is-3-mobile") %>
        <%= t_field(form, :localidad, label: "Localidad", placeholder: "Ej. Localidad", clas: "field column is-6-desktop is-6-tablet is-6-mobile") %>
        <%= t_field(form, :calle, label: "Calle", placeholder: "Ej. Calle", clas: "field column is-8-desktop is-6-tablet is-6-mobile") %>
        <%= t_field(form, :num_exterior, label: "# Exterior", placeholder: "Ej. 123", clas: "field column is-2-desktop is-3-tablet is-3-mobile") %>
        <%= t_field(form, :num_interior, label: "# Interior", placeholder: "Ej. ABC", clas: "field column is-2-desktop is-3-tablet is-3-mobile") %>
      </div>
    </div>
  </div>
  <div class="field is-grouped is-justify-content-space-between mt-5">
    <div class="control">
      <%= link_to "Cancelar", providers_path, class: "button is-rounded" %>
    </div>
    <div class="control">
      <%= form.submit "Guardar", class: "button is-rounded is-primary" %>
    </div>
  </div>
<% end %>