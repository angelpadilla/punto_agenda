<% content_for :title, "Compras y gastos" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Compras y gastos</h2>
  <div class="actions">
    <%= link_to new_purchase_path(tipo: "compra"), class: "button is-primary is-rounded" do  %>
      <span class="icon mr-2">
        <%= image_tag 'plus.svg', alt: 'carrito' %>
      </span>
      Nueva compra
    <% end %>
    <%= link_to new_purchase_path(tipo: "gasto"), class: "button is-primary is-rounded" do  %>
      <span class="icon mr-2">
        <%= image_tag 'plus.svg', alt: 'carrito' %>
      </span>
      Nuevo gasto
    <% end %>
    <div class="button is-rounded">
      <span class="icon ai_aqui">
        <%= image_tag 'wand.svg', alt: 'filter', class: 'invert' %>
      </span>
    </div>
    <div class="dropdown is-right is-hoverable">
      <div class="dropdown-trigger">
        <button class="button is-rounded" aria-haspopup="true">
          <span class="icon">
            <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
          </span>
          <span>Acciones</span>
        </button>
      </div>
      <% if false %>
        <div class="dropdown-menu" role="menu">
          <div class="dropdown-content">
            <%= link_to "#", class: "dropdown-item" do  %>
              <span class="icon">
                <%= image_tag 'download.svg', alt: 'download', class: 'invert' %>
              </span>
              Exportar CSV
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<hr>
<%= search_form_for @q, url: purchases_path, data: { controller: "focus-search" } do |f| %>
  <div class="columns is-multiline">
    <div class="column is-3">
      <%= f.search_field :folio_eq, class: 'is-rounded search_input', placeholder: 'Folio', data: { focus_search_target: "inputt" } %>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :provider_id_eq, options_for_select(@corp.providers.map {|c| [c.razon, c.id]}, @q.provider_id_eq), {prompt: "Proveedor"}, {class: ""} %>
      </div>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :tipo_eq, options_for_select(Purchase.tipos.keys.map { |k| [k.humanize, k] }, (params[:q] and !params[:q][:tipo_eq].blank?) ? params[:q][:tipo_eq] : nil), {prompt: "Tipo"}, {class: ""} %>
      </div>
    </div>
    <%# status pago %>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :status_pago_eq, options_for_select(Purchase.status_pagos.keys.map { |k| [k.humanize, k] }, (params[:q] and !params[:q][:status_pago_eq].blank?) ? params[:q][:status_pago_eq] : nil), {prompt: "Estatus pago"}, {class: ""} %>
      </div>
    </div>
    <%# status %>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :status_eq, options_for_select(Purchase::Status3, (params[:q] and !params[:q][:status_eq].blank?) ? params[:q][:status_eq] : nil), {prompt: "Estatus"}, {class: ""} %>
      </div>
    </div>
    <div class="column is-2">
      <div class="buttons">
        <%= f.submit 'Buscar', class: "button is-rounded is-primary" %>
        <%= link_to purchases_path, class: "button is-rounded has_tooltip" do  %>
          <span class="icon reset">
            <%= image_tag 'trash.svg', alt: 'clear', class: 'invert' %>
          </span>
          <div class="tooltip down">Limpiar busqueda</div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<div class="table_box">
  <div class="table_header flexx">
    <div class="table_cell"><%= sort_link(@q, :status, 'Status') %></div>
    <div class="table_cell"><%= sort_link(@q, :tipo, 'Tipo') %></div>
    <div class="table_cell"><%= sort_link(@q, :provider_id, 'Proveedor') %></div>
    <div class="table_cell"><%= sort_link(@q, :status_pago, 'Estatus pago') %></div>
    <div class="table_cell"><%= sort_link(@q, :fecha, 'Fecha') %></div>
  </div>
  <div class="table_content">
    <%= render @purchases %>
  </div>
</div>
<% if @pagy.pages > 1 %>
  <br>
  <%== @pagy.series_nav(:bulma) %>
  <br>
<% end %>
<br>
<br>