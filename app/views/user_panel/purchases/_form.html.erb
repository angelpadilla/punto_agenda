  <%= form_with(model: purchase, url: path, method: method, data: {controller: 'form-purchase'}) do |form| %>
  <section class="modal-card-body">
    <% if purchase.errors.any? %>
      <div class="notification is-warning mt-4">
        <h2 class="subtitle"><%= pluralize(purchase.errors.count, "error", "errores") %> impidieron que esta razon se guardara:</h2>
        <ul>
          <% purchase.errors.each do |error| %>
            <li><%= error.message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="columns is-multiline">
      <div class="field column is-12">
        <label class="label">Proovedor</label>
        <div class="control is-expanded <%= purchase.errors.include?(:provider_id) ? 'select-is-danger' : '' %>">
          <%= form.select :provider_id, options_for_select(@corp.providers.default.map { |k| ["#{k.razon&.titleize} #{k.tel}", k.id] }, params[:provider_id] || purchase.provider_id),
              {prompt: "Selecciona", required: field_required?(Purchase, :provider_id)},
              { "data-controller": "slimselect", class: "ss2"}
              %>
        </div>
      </div>
      <div class="field column is-6">
        <label class="label">Fecha venta</label>
        <%= form.date_field :fecha, class: 'control input is-rounded', max: Date.today, value: Date.today, required: true %>
      </div>
      <%= s_field(form, :status, options: Purchase::Status2, label: "Status", clas: "field column is-6") %>
      <div class="field column is-12">
        <label class="label">Forma pago</label>
        <div class="select is-rounded <%= purchase.errors.include?(:forma_pago) ? 'is-danger' : '' %>">
          <%= form.select(:forma_pago, Purchase.forma_pagos.keys.map { |k| [k.humanize, k] }, {}) %>
        </div>
      </div>
      <%= s_field(form, :status_pago, options: Purchase.status_pagos.keys.map { |k| [k.to_s.humanize, k] }, label: "Estado de pago", clas: "field column is-12") %>
      <div class="field column is-12">
        <label class="label">Fecha limite del credito</label>
        <%= form.date_field :deadline, class: "control input #{purchase.errors.include?(:deadline) ? 'is-danger' : ''}", min: Time.current %>
      </div>
    </div>
    <div class="columns is-multiline mt-2">
      <%= t_field(form, :nota_customer, placeholder: "Nota interna", clas: "field column is-12") %>
    </div>
  </section>
  <footer class="modal-card-foot">
    <%= form.submit "Finalizar", class: "button is-rounded is-primary is-fullwidth" %>
  </footer>
<% end %>