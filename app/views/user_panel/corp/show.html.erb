<div class="box expandable">
  <div class="box_header">
    <h2>
      <span class="icon mr-2">
        <%= image_tag 'lightbulb-bolt-svgrepo-com.svg', alt: "Configuración", class: "invert" %>
      </span>
      Configuración
    </h2>
    <span class="icon toggle_icon">
      <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
    </span>
  </div>
  <div class="box_content">
    <label class="toggle_field disabled">
      <div class="toggle_info">
        <span class="toggle_label">Acepta pagos en línea</span>
        <span class="toggle_desc">Habilita pagos para citas y pedidos en línea</span>
      </div>
      <% if @corp.online_payments %>
        <input type="checkbox" class="toggle_input" checked disabled>
      <% else %>
        <input type="checkbox" class="toggle_input" disabled>
      <% end %>
      <span class="toggle_track">
        <span class="toggle_thumb"></span>
      </span>
    </label>
    <label class="toggle_field disabled">
      <div class="toggle_info">
        <span class="toggle_label">Facturacion?</span>
        <span class="toggle_desc">Activa si tu negocio realiza facturación</span>
      </div>
      <% if @corp.facturacion %>
        <input type="checkbox" class="toggle_input" checked disabled>
      <% else %>
        <input type="checkbox" class="toggle_input" disabled>
      <% end %>
      <span class="toggle_track">
        <span class="toggle_thumb"></span>
      </span>
    </label>
    <label class="toggle_field disabled">
      <div class="toggle_info">
        <span class="toggle_label">Calendario?</span>
        <span class="toggle_desc">Activa si tu negocio utiliza un calendario para gestionar citas o eventos</span>
      </div>
      <% if @corp.calendar %>
        <input type="checkbox" class="toggle_input" checked disabled>
      <% else %>
        <input type="checkbox" class="toggle_input" disabled>
      <% end %>
      <span class="toggle_track">
        <span class="toggle_thumb"></span>
      </span>
    </label>
    <label class="toggle_field disabled">
      <div class="toggle_info">
        <span class="toggle_label">Calendario público?</span>
        <span class="toggle_desc">Habilita tu calendario público, para que tus clientes puedan ver tus horarios y hacer citas</span>
      </div>
      <% if @corp.public_calendar %>
        <input type="checkbox" class="toggle_input" checked disabled>
      <% else %>
        <input type="checkbox" class="toggle_input" disabled>
      <% end %>
      <span class="toggle_track">
        <span class="toggle_thumb"></span>
      </span>
    </label>
    <label class="toggle_field disabled">
      <div class="toggle_info">
        <span class="toggle_label">Catálogo de productos público?</span>
        <span class="toggle_desc">Habilita tu catálogo de productos público, para que tus clientes puedan ver tus productos y hacer pedidos</span>
      </div>
      <% if @corp.public_site %>
        <input type="checkbox" class="toggle_input" checked disabled>
      <% else %>
        <input type="checkbox" class="toggle_input" disabled>
      <% end %>
      <span class="toggle_track">
        <span class="toggle_thumb"></span>
      </span>
    </label>
  </div>
</div>
<%# show horarios de atencion %>
<% if @corp.calendar %>
  <div class="box expandable">
    <div class="box_header">
      <h2>
        <span class="icon mr-2">
          <%= image_tag 'calendar.svg', alt: "Horarios de atención", class: "invert" %>
        </span>
        Horarios de atención
      </h2>
      <span class="icon toggle_icon">
        <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
      </span>
    </div>
    <div class="box_content">
      <table class="table is-fullwidth">
        <thead>
          <tr>
            <th>Día</th>
            <th>Abierto</th>
            <th>Slots / Horarios</th>
          </tr>
        </thead>
        <tbody>
          <% Corp::DAYS_OF_WEEK.each do |wday, day_name| %>
            <% day_config = @corp.business_hours&.dig(wday) || { "active" => false, "hours" => [ { "open" => "09:00", "close" => "18:00" } ] } %>
            <% is_active = ActiveModel::Type::Boolean.new.cast(day_config["active"]) %>
            <% hours_list = day_config["hours"].presence || [] %>
            <tr>
              <td><strong><%= day_name %></strong></td>
              <td>
                <% if is_active %>
                  <span class="tag is-rounded is-success is-light">Abierto</span>
                <% else %>
                  <span class="tag is-rounded is-light">Cerrado</span>
                <% end %>
              </td>
              <td>
                <% if is_active && hours_list.any? %>
                  <% hours_list.each do |h| %>
                    <span class="tag is-info is-light mr-1"><%= h["open"] %> – <%= h["close"] %></span>
                  <% end %>
                <% else %>
                  <span class="has-text-grey">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="columns is-multiline is-mobile mt-3">
        <% if @corp.online_payments and  @corp.public_calendar %>
          <div class="column is-6-desktop is-12-mobile">
            <div class="labell">Monto minimo para agendar</div>
            <p class="contentt"><%= number_to_currency(@corp.min_book_amount) %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
