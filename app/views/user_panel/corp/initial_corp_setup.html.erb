<% content_for :title, "Configura tu empresa" %>
<div data-controller="corp-setup">
  <%# ── Header ──────────────────────────────────────────────────────── %>
  <div class="mb-5">
    <h1 class="titlee">👋 Bienvenido<%= ", #{@corp.name}" if @corp.name.present? %></h1>
    <p class="has-text-grey">Completa los siguientes pasos para dejar tu empresa lista.</p>
  </div>
  <%# ── Progress bar ───────────────────────────────────────────────── %>
  <div class="mb-5">
    <div class="is-flex is-align-items-center is-justify-content-space-between mb-2">
      <span class="tag is-rounded is-light" data-corp-setup-target="progressText">Paso 1 de 3</span>
    </div>
    <progress class="progress is-primary is-small"
              data-corp-setup-target="progressBar"
              value="33" max="100">33%</progress>
  </div>
  <%# ── Validation errors ───────────────────────────────────────────── %>
  <% if @corp.errors.any? %>
    <div class="notification is-warning mt-4">
      <h2 class="subtitle"><%= pluralize(@corp.errors.count, "error", "errores") %> impidieron guardar:</h2>
      <ul>
        <% @corp.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form_with(model: @corp, method: :patch, url: save_initial_corp_setup_path,
                data: { corp_setup_target: "form", turbo: false }) do |form| %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# PASO 1 — Datos básicos + Datos fiscales                         %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <div data-corp-setup-target="step">
      <div class="box expandable is_active mt-4">
        <div class="box_header">
          <h2>
            <span class="icon mr-2">
              <%= image_tag 'documento.svg', alt: "Datos básicos", class: "invert" %>
            </span>
            Datos básicos
          </h2>
          <span class="icon toggle_icon">
            <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
          </span>
        </div>
        <div class="box_content">
          <div class="columns is-multiline">
            <%= t_field(form, :name, label: "Nombre comercial", placeholder: "Ej. Mi Empresa", clas: "field column is-12") %>
            <%= e_field(form, :email, label: "Email contacto", placeholder: "Ej. contacto@empresa.com", clas: "field column is-6") %>
            <div class="field has-addons column is-6">
              <div class="control <%= @corp.errors.include?(:tel_prefix) ? 'select-is-danger' : '' %>">
                <label class="label">* Teléfono o WhatsApp contacto</label>
                <%= form.select :tel_prefix,
                        options_for_select(Customer::TelPrefixes.map { |k, v| ["#{v} (#{k})", k] }, @corp.tel_prefix),
                        { prompt: "Selecciona", required: field_required?(Corp, :tel_prefix) },
                        { "data-controller": "slimselect", class: "ss2" } %>
              </div>
              <%= t_field(form, :phone, label: "Teléfono", placeholder: "Ej. 1234567890", clas: "control is-expanded", label_ghost: true) %>
            </div>
            <%= s_field(form, :tipo_negocio, options: Corp::TipoNegocios, label: "Tipo de negocio", clas: "field column is-12") %>
            <div class="column is-12-mobile">
              <div class="doc_input">
                <div class="doc_file_name"></div>
                <div class="doc_file_size">JPG o PNG · max 5MB</div>
                <%= form.file_field :logo, class: "doc_file_field", accept: ".png, .jpg, .jpeg",
                      data: { action: "change->corp-setup#previewDoc" } %>
                <span class="doc_action">Selecciona logo</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="box expandable mt-4">
        <div class="box_header">
          <h2>
            <span class="icon mr-2">
              <%= image_tag 'sat2.svg', alt: "Datos fiscales" %>
            </span>
            Datos fiscales
            <span class="tag is-light ml-3" style="font-size:0.75rem;font-weight:400;">Opcional</span>
          </h2>
          <span class="icon toggle_icon">
            <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
          </span>
        </div>
        <div class="box_content">
          <div class="columns is-multiline is-mobile">
            <%= t_field(form, :razon, label: "Razón fiscal", placeholder: "Ej. Mi Empresa S.A. de C.V.") %>
            <%= s_field(form, :regimen, options: Corp::RegimenFiscales, label: "Régimen fiscal", clas: "field column is-12-mobile is-6-tablet is-4-desktop") %>
            <%= t_field(form, :rfc, label: "RFC", placeholder: "Ej. XAXX010101000", clas: "field column is-12-mobile is-6-tablet is-4-desktop") %>
            <%= s_field(form, :estado, options: Corp::States, label: "Estado", clas: "field column is-12-mobile is-6-tablet is-4-desktop") %>
            <%= t_field(form, :ciudad, label: "Ciudad", placeholder: "Ej. Ciudad de México", clas: "field column is-12-mobile is-6-tablet is-4-desktop") %>
            <%= t_field(form, :cp, label: "Código Postal", placeholder: "Ej. 01234", clas: "field column is-12-mobile is-6-tablet is-4-desktop") %>
            <%= t_field(form, :colonia, label: "Colonia", placeholder: "Ej. Colonia Centro", clas: "field column is-12-mobile is-6-tablet is-4-desktop") %>
            <%= t_field(form, :localidad, label: "Localidad", placeholder: "Ej. Localidad Ejemplo", clas: "field column is-12-mobile is-6-tablet is-4-desktop") %>
          </div>
          <div class="columns is-multiline is-mobile">
            <%= t_field(form, :calle, label: "Calle", placeholder: "Ej. Calle Falsa", clas: "field column is-12-mobile is-6-tablet is-8-desktop") %>
            <%= t_field(form, :num_ext, label: "Número Exterior", placeholder: "Ej. 123", clas: "field column is-3-tablet is-2-desktop") %>
            <%= t_field(form, :num_int, label: "Número Interior", placeholder: "Ej. 456", clas: "field column is-3-tablet is-2-desktop") %>
          </div>
          <div class="columns is-multiline is-mobile">
            <%= t_field(form, :key_pass, label: "Contraseña de la llave", placeholder: "Ej. XAXX010101000", clas: "field column is-12") %>
            <div class="column is-12-mobile is-6-tablet is-6-desktop">
              <div class="doc_input">
                <div class="doc_file_name"></div>
                <div class="doc_file_size"></div>
                <%= form.file_field :cer, class: "doc_file_field", accept: ".cer", data: { action: "change->corp-setup#previewDoc" } %>
                <span class="doc_action">Seleccionar archivo .cer</span>
              </div>
            </div>
            <div class="column is-12-mobile is-6-tablet is-6-desktop">
              <div class="doc_input">
                <div class="doc_file_name"></div>
                <div class="doc_file_size"></div>
                <%= form.file_field :key, class: "doc_file_field", accept: ".key", data: { action: "change->corp-setup#previewDoc" } %>
                <span class="doc_action">Seleccionar archivo .key</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <%# /step 1 %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# PASO 2 — Configuración (togglers)                               %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <div data-corp-setup-target="step" style="display:none">
      <div class="box expandable is_active mt-4">
        <div class="box_header">
          <h2>
            <span class="icon mr-2">
              <%= image_tag 'lightbulb-bolt-svgrepo-com.svg', alt: "Configuración", class: "invert" %>
            </span>
            Configuración
          </h2>
          <span class="icon toggle_icon">
            <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
          </span>
        </div>
        <div class="box_content">
          <label class="toggle_field">
            <div class="toggle_info">
              <span class="toggle_label">Acepta pagos en línea</span>
              <span class="toggle_desc">Habilita pagos para citas y pedidos en línea</span>
            </div>
            <%= form.check_box :online_payments, class: "toggle_input", data: { action: "corp-setup#toggleMinBookAmount", corp_setup_target: "onlinePaymentsCheck" } %>
            <span class="toggle_track"><span class="toggle_thumb"></span></span>
          </label>
          <label class="toggle_field">
            <div class="toggle_info">
              <span class="toggle_label">¿Facturación?</span>
              <span class="toggle_desc">Activa si tu negocio realiza facturación electrónica</span>
            </div>
            <%= form.check_box :facturacion, class: "toggle_input" %>
            <span class="toggle_track"><span class="toggle_thumb"></span></span>
          </label>
          <label class="toggle_field">
            <div class="toggle_info">
              <span class="toggle_label">Activar calendario</span>
              <span class="toggle_desc">Activa si tu negocio gestiona citas o eventos con un calendario</span>
            </div>
            <%= form.check_box :calendar, class: "toggle_input",
                  data: { corp_setup_target: "calendarCheck", action: "corp-setup#calendarChanged" } %>
            <span class="toggle_track"><span class="toggle_thumb"></span></span>
          </label>
          <label class="toggle_field">
            <div class="toggle_info">
              <span class="toggle_label">Calendario público?</span>
              <span class="toggle_desc">Habilita tu calendario público, para que tus clientes puedan ver tus horarios y hacer citas</span>
            </div>
            <%= form.check_box :public_calendar, class: "toggle_input", data: { action: "corp-setup#toggleMinBookAmount", corp_setup_target: "publicCalendarCheck" } %>
            <span class="toggle_track">
              <span class="toggle_thumb"></span>
            </span>
          </label>
          <label class="toggle_field">
            <div class="toggle_info">
              <span class="toggle_label">Catálogo de productos público?</span>
              <span class="toggle_desc">Habilita tu catálogo de productos público, para que tus clientes puedan ver tus productos y hacer pedidos</span>
            </div>
            <%= form.check_box :public_site, class: "toggle_input" %>
            <span class="toggle_track"><span class="toggle_thumb"></span></span>
          </label>
          <div class="columns is-multiline mt-2">
            <%= n_field(form, :min_book_amount, label: "Monto minimo para agendar", placeholder: "Ej. $100.00", min: 100.0, help: "Este es el monto mínimo que un cliente debe pagar para agendar una cita, el monto minimo es de $100.00 MXN, si lo dejas en blanco será gratis.", clas: "field column is-12 minBookAmountContainer") %>
          </div>
        </div>
      </div>
    </div>
    <%# /step 2 %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <%# PASO 3 — Horario de atención (solo si activó calendario)        %>
    <%# ════════════════════════════════════════════════════════════════ %>
    <div data-corp-setup-target="step" style="display:none">
      <div class="box expandable is_active mt-4">
        <div class="box_header">
          <h2>
            <span class="icon mr-2">
              <%= image_tag 'calendar.svg', alt: "Horario", class: "invert" %>
            </span>
            Horario de atención
          </h2>
          <span class="icon toggle_icon">
            <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
          </span>
        </div>
        <div class="box_content">
          <% horas = (0..23).flat_map { |h| [0, 15, 30, 45].map { |m| format("%02d:%02d", h, m) } } %>
          <table class="table is-fullwidth">
            <thead>
              <tr>
                <th>Día</th>
                <th>Abierto</th>
                <th>Slots / Rangos de horario</th>
              </tr>
            </thead>
            <tbody>
              <% Corp::DAYS_OF_WEEK.each do |wday, day_name| %>
                <% day_config = @corp.business_hours&.dig(wday) || Corp::DEFAULT_BUSINESS_HOURS[wday] %>
                <% is_active = ActiveModel::Type::Boolean.new.cast(day_config["active"]) %>
                <% hours_list = day_config["hours"].presence || [ { "open" => "09:00", "close" => "18:00" } ] %>
                <% hours_list = hours_list.values if hours_list.is_a?(Hash) %>
                <tr>
                  <td><strong><%= day_name %></strong></td>
                  <td>
                    <%= hidden_field_tag "corp[business_hours][#{wday}][active]", "0" %>
                    <%= check_box_tag "corp[business_hours][#{wday}][active]", "1", is_active,
                          data: { action: "corp-setup#toggle", corp_setup_wday_param: wday },
                          class: "checkbox" %>
                  </td>
                  <td>
                    <div data-corp-setup-target="hoursContainer" data-wday="<%= wday %>">
                      <button type="button" class="button is-small mb-1"
                        data-action="corp-setup#addHour"
                        data-corp-setup-wday-param="<%= wday %>"
                        <%= is_active ? "" : "disabled" %>>
                        + Agregar slot
                      </button>
                      <% hours_list.each_with_index do |hour, idx| %>
                        <div class="hour-range is-flex is-align-items-center mb-1" data-wday="<%= wday %>" data-index="<%= idx %>">
                        <div class="select is-small mr-1">
                          <%= select_tag "corp[business_hours][#{wday}][hours][#{idx}][open]",
                                  options_for_select(horas, hour["open"]),
                                  disabled: !is_active, class: "select-time",
                                  data: { action: "change->corp-setup#validateHourRange", corp_setup_wday_param: wday } %>
                        </div>
                        <span class="mx-1">–</span>
                        <div class="select is-small mr-1">
                          <%= select_tag "corp[business_hours][#{wday}][hours][#{idx}][close]",
                                  options_for_select(horas, hour["close"]),
                                  disabled: !is_active, class: "select-time",
                                  data: { action: "change->corp-setup#validateHourRange", corp_setup_wday_param: wday } %>
                        </div>
                        <% if idx > 0 %>
                          <button type="button" class="button is-small is-danger is-light ml-1"
                                    data-action="corp-setup#removeHour"
                                    data-corp-setup-wday-param="<%= wday %>"
                                    data-corp-setup-index-param="<%= idx %>"
                                    <%= is_active ? "" : "disabled" %>>✕</button>
                          <% end %>
                        </div>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <%# /step 3 %>
        <%# ── Navigation buttons ───────────────────────────────────────── %>
        <div class="field is-grouped is-justify-content-space-between mt-5">
          <div class="control">
            <button type="button" class="button is-rounded"
                data-corp-setup-target="prevBtn"
                data-action="corp-setup#prev"
                style="display:none">← Anterior</button>
          </div>
          <div class="control">
            <button type="button" class="button is-rounded is-primary"
                data-corp-setup-target="nextBtn"
                data-action="corp-setup#next">Siguiente →</button>
          </div>
        </div>
      <% end %>
    </div>
    <br>
    <br>
