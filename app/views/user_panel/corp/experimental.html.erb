<%# ── Telegram ── %>
<div class="box expandable mt-4">
  <div class="box_header">
    <h2>
      <span class="icon mr-2">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0m5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394a.76.76 0 0 1-.6.295h-.005l.213-3.054 5.56-5.023c.24-.213-.054-.334-.373-.121l-6.87 4.326-2.96-.924c-.64-.203-.658-.64.135-.954L17.06 7.28c.538-.196 1.006.128.832.941z"/></svg>
      </span>
      Notificaciones Telegram
    </h2>
    <span class="icon toggle_icon">
      <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
    </span>
  </div>
  <div class="box_content">
    <% if @corp.telegram_id.present? %>
      <p class="mb-3">
        <span class="tag is-success">Vinculado</span>
      </p>
      <p class="help mb-3">
        Vinculado el <%= l(@corp.telegram_linked_at, format: :short) %>
      </p>
      <%= link_to telegram_unlink_path, data: { turbo_method: :delete, turbo_confirm: "¿Desvincular Telegram?" }, class: "button is-small is-rounded is-danger" do %>
        Desvincular
      <% end %>
    <% else %>
      <p class="help mb-3">
        Recibe notificaciones de tu negocio directamente en Telegram.
      </p>
      <% if Rails.application.credentials.dig(:telegram, :bot_username).present? %>
        <div class="mb-3">
          <script async src="https://telegram.org/js/telegram-widget.js?22" data-telegram-login="<%= Rails.application.credentials.dig(:telegram, :bot_username) %>" data-size="medium" data-auth-url="<%= telegram_callback_url %>" data-request-access="write"></script>
        </div>
        <p class="has-text-centered text-gray mb-3" style="font-size: 0.8rem;">o</p>
      <% end %>
      <%= link_to telegram_link_corp_path, class: "button is-small is-rounded is-info" do %>
        <span class="icon is-small mr-1">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0m5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394a.76.76 0 0 1-.6.295h-.005l.213-3.054 5.56-5.023c.24-.213-.054-.334-.373-.121l-6.87 4.326-2.96-.924c-.64-.203-.658-.64.135-.954L17.06 7.28c.538-.196 1.006.128.832.941z"/></svg>
        </span>
        Vincular vía bot
      <% end %>
    <% end %>
  </div>
</div>
<%= expandable_box "Impresora POS", icon: "dots.svg", inverted_icon: true, active: true do  %>
  <%= form_with url: experimental_save_path, method: :post do |f|  %>
    <div class="columns">
    </div>
    <label class="toggle_field">
      <div class="toggle_info">
        <span class="toggle_label">Impresora nativa?</span>
        <span class="toggle_desc">Activa si tu negocio utiliza impresora nativa</span>
      </div>
      <%= f.check_box :printer_nativo, class: "toggle_input", checked: @corp.printer_nativo %>
      <span class="toggle_track">
        <span class="toggle_thumb"></span>
      </span>
    </label>
    <button class="button is-rounded is-primary is-fullwidth mt-4" type="submit">Guardar</button>
  <% end %>
