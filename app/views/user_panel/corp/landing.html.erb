<% content_for :title, "Ajustes" %>
<div class="box expandable mt-4 is_active">
  <div class="box_header">
    <h2>
      <span class="icon mr-2">
        <%= image_tag 'lightbulb-bolt-svgrepo-com.svg', alt: "Configuración", class: "invert" %>
      </span>
      <%= @corp.name.titleize %>
      <% if @corp.premium? %>
        <span class="tag is-success is-rounded"><%= @corp.tipo_plan.titleize %></span>
      <% elsif @corp.plus? %>
        <span class="tag is-info is-rounded"><%= @corp.tipo_plan.titleize %></span>
      <% else %>
        <span class="tag is-info is-rounded"><%= @corp.tipo_plan.titleize %></span>
      <% end %>
      <% if @corp.suspendido? %>
        <span class="tag is-danger is-rounded">Suspendido</span>
      <% end %>
    </h2>
    <span class="icon toggle_icon">
      <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
    </span>
  </div>
  <div class="box_content">
    <div class="columns is-multiline is-mobile">
      <div class="column is-6-mobile is-6-tablet is-4-desktop">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">store</span>
          <div>
            <p class="labell">Tipo Negocio </p>
            <p><%= @corp.tipo_negocio&.titleize %></p>
          </div>
        </div>
      </div>
      <div class="column is-6-mobile is-6-tablet is-4-desktop">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">fingerprint</span>
          <div>
            <p class="labell">ID tienda</p>
            <p><%= @corp.sku %>-<%= @corp.id %></p>
          </div>
        </div>
      </div>
      <% if @corp.discount > 0 %>
        <div class="column is-6-mobile is-6-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">percent</span>
            <div>
              <p class="labell">Descuento en pagos</p>
              <p class="has-text-neon">-<%= number_to_currency @corp.discount %></p>
            </div>
          </div>
        </div>
      <% end %>
      <div class="column is-6-mobile is-6-tablet is-4-desktop">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">sms</span>
          <div>
            <p class="labell">SMS disponibles</p>
            <p><%= @corp.sms %></p>
          </div>
        </div>
      </div>
      <% if @corp.facturacion? %>
        <div class="column is-6-mobile is-6-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">fingerprint</span>
            <div>
              <p class="labell">Timbres</p>
              <p><%= @corp.timbres %></p>
            </div>
          </div>
        </div>
      <% end %>
      <% if @corp.online_payments and  @corp.public_calendar %>
        <div class="column is-6-mobile is-6-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">paid</span>
            <div>
              <p class="labell">Monto minimo para agendar</p>
              <p><%= number_to_currency(@corp.min_book_amount) %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="columns is-multiline is-mobile">
      <div class="column is-6-mobile is-4-tablet is-4-desktop">
        <div class="flexx">
          <span class="icon material-icons-round mr-2">calendar_month</span>
          <div>
            <p class="labell">Ultimo pago</p>
            <p>
              <%= @corp.subscription_updated_at ? l(@corp.subscription_updated_at, format: :long) : 'N/A' %>
            </p>
          </div>
        </div>
      </div>
      <% if @corp.moroso? %>
        <div class="column is-6-mobile is-4-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">fingerprint</span>
            <div>
              <p class="labell">Intento de pago fallidos</p>
              <p>
                <%= @corp.payment_attempts %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
      <% if @corp.probando? %>
        <div class="column is-6-mobile is-4-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">calendar_month</span>
            <div>
              <p class="labell">Inicio de prueba</p>
              <p>
                <%= @corp.subscription_trial_start ? l(@corp.subscription_trial_start, format: :long) : 'N/A' %>
              </p>
            </div>
          </div>
        </div>
        <div class="column is-6-mobile is-4-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">calendar_month</span>
            <div>
              <p class="labell">Fin de prueba</p>
              <p>
                <%= @corp.subscription_trial_end ? l(@corp.subscription_trial_end, format: :long) : 'N/A' %>
              </p>
            </div>
          </div>
        </div>
      <% else %>
        <div class="column is-6-mobile is-4-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">calendar_month</span>
            <div>
              <p class="labell">Inicio de suscripción</p>
              <p>
                <%= @corp.subscription_started_at ? l(@corp.subscription_started_at, format: :long) : 'N/A' %>
              </p>
            </div>
          </div>
        </div>
        <div class="column is-6-mobile is-4-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">calendar_month</span>
            <div>
              <p class="labell">Siguiente pago programado</p>
              <p>
                <%= @corp.subscription_next_billing_date ? l(@corp.subscription_next_billing_date, format: :long) : 'N/A' %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <% if @corp.stripe_payment_method_id.present? %>
      <div class="columns is-multiline is-mobile">
        <div class="column is-6-mobile is-4-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon mr-1">
              <% if @corp.card_brand == 'visa' %>
                <%= image_tag 'visa.svg', alt: 'Visa', class: 'invert' %>
              <% elsif @corp.card_brand == 'mastercard' %>
                <%= image_tag 'mastercard.svg', alt: 'Mastercard', class: 'invert' %>
              <% else %>
                <%= image_tag 'layers.svg', alt: 'login', class: 'invert' %>
              <% end %>
            </span>
            <div>
              <p class="labell">Marca de tarjeta</p>
              <p><%= @corp.card_brand&.titleize %></p>
            </div>
          </div>
        </div>
        <div class="column is-6-mobile is-4-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">payment</span>
            <div>
              <p class="labell"># Tarjeta</p>
              <p>**** **** **** <%= @corp.card_last4 %></p>
            </div>
          </div>
        </div>
        <div class="column is-6-mobile is-4-tablet is-4-desktop">
          <div class="flexx">
            <span class="icon material-icons-round mr-2">payment</span>
            <div>
              <p class="labell">Tarjeta MM/YY</p>
              <p><%= @corp.card_exp_month %>/<%= @corp.card_exp_year %></p>
            </div>
          </div>
        </div>
      </div>
    <% end %>
    <div class="columns is-multiline is-mobile">
      <div class="column is-12-mobile is-4-tablet is-4-desktop">
        <div class="labell">
          Tarjeta asociada
          <% if @corp.stripe_payment_method_id.present? %>
            <span class="tag is-success is-rounded">Sí</span>
          <% end %>
        </div>
        <div class="contentt">
          <%= button_to stripe_new_card_path, class: "button is-rounded is-info", data: {turbo: false} do %>
            <% if @corp.stripe_payment_method_id.present? %>
              <span class="icon mr-1">
                <%= image_tag 'card-transfer-svgrepo-com.svg', alt: 'login', class: 'invert' %>
              </span>
              Cambiar tarjeta
            <% else %>
              <span class="icon mr-1">
                <%= image_tag 'card-send-svgrepo-com.svg', alt: 'login', class: 'invert' %>
              </span>
              Asociar tarjeta
            <% end %>
          <% end %>
        </div>
      </div>
      <div class="column is-12-mobile is-4-tablet is-4-desktop">
        <div class="labell">
          Plan
          <% if @corp.premium? %>
            <span class="tag is-success is-rounded"><%= @corp.tipo_plan.titleize %></span>
          <% end %>
        </div>
        <div class="contentt">
          <div class="button is-rounded is-info mtrigger" data-target="plan_modal">
            <span class="icon mr-1">
              <%= image_tag 'bolt.svg', alt: 'login', class: 'invert' %>
            </span>
            Cambiar plan
          </div>
          <div id="plan_modal" class="modal">
            <div class="modal-background"></div>
            <div class="modal-content">
              <div class="box">
                <h3 class="title is-4">Cambiar plan</h3>
                <div class="noti is-danger">
                  <h2>
                    <span class="icon material-icons-round">warning</span>
                    Atención
                  </h2>
                  <p class="mt-2">El elegir un nuevo plan, se hara el cobro del monto correspondiente en tu tarjeta, y se te habilitaran las funciones del nuevo plan inmediatamente.</p>
                </div>
                <% if @corp.discount > 0 %>
                  <div class="noti is-main mt-4">
                    <h2>
                      <span class="icon material-icons-round">percent</span>
                      Descuento aplicado
                    </h2>
                    <p class="mt-2">Tienes un descuento de <strong><%= number_to_currency @corp.discount %></strong> en tus pagos mensuales, el cual se aplicará automáticamente al cambiar de plan. ¡Aprovecha este descuento!</p>
                  </div>
                <% end %>
                <% if @corp.stripe_payment_method_id.present? %>
                  <% Setting::PlanPrices.each do |key, info| %>
                    <div class="box_box">
                      <div class="labell"><%= info[:name] %></div>
                      <p class="contentt mb-2">
                        $<%= info[:price] %>/mes MXN
                      </p>
                      <%= button_to change_plan_path(plan: key), class: "button is-primary is-rounded is-fullwidth", disabled: @corp.tipo_plan == key.to_s do  %>
                        <span class="icon mr-1">
                          <%= image_tag 'circle-bottom-up-svgrepo-com.svg', alt: 'login' %>
                        </span>
                        Elegir
                      <% end %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="box_box">
                    <div class="labell">No tienes una tarjeta asociada</div>
                    <p class="">
                      Para cambiar de plan, primero debes asociar una tarjeta de crédito o débito a tu cuenta.
                    </p>
                    <%= button_to stripe_new_card_path, class: "button is-primary is-rounded is-fullwidth", data: {turbo: false} do  %>
                      <span class="icon mr-1">
                        <%= image_tag 'card-send-svgrepo-com.svg', alt: 'login' %>
                      </span>
                      Asociar tarjeta
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
            <button class="modal-close is-large" aria-label="close"></button>
          </div>
        </div>
      </div>
      <% if @corp.payment_attempts > 0 or @corp.suspendido? %>
        <div class="column is-12-mobile is-4-tablet is-4-desktop">
          <div class="labell">
            Intentos de pago fallidos
            <span class="tag is-danger is-rounded"><%= @corp.payment_attempts %></span>
          </div>
          <div class="contentt">
            <% if @corp.stripe_payment_method_id.present? %>
              <%= button_to pay_now_path, class: "button is-rounded is-info" do %>
                <span class="icon mr-1">
                  <%= image_tag 'circle-bottom-up-svgrepo-com.svg', alt: 'login', class: 'invert' %>
                </span>
                Pagar ahora
              <% end %>
            <% else %>
              <%= button_to stripe_new_card_path, class: "button is-rounded is-info", data: {turbo: false} do %>
                <span class="icon mr-1">
                  <%= image_tag 'card-send-svgrepo-com.svg', alt: 'login', class: 'invert' %>
                </span>
                Asociar tarjeta primero
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<div class="box is-main">
  <div class="columns is-multiline is-mobile">
    <div class="column is-12">
      <h2>Balance</h2>
      <p><%= number_to_currency @balance %></p>
      <p class="help">
        El balance representa los fondos disponibles para retiro, calculados como la suma de los depósitos pagados a través de Tarjetas de credito/debito en tu tienda, menos las comisiones correspondientes. El monto minimo para poder retirar fondos es de <%= number_to_currency(Setting::MontoMinimoRetiro) %> MXN. Los retiros se procesan manualmente y pueden tardar hasta 72 horas hábiles en reflejarse en tu cuenta bancaria.
      </p>
    </div>
    <% retiro = @corp.last_for_retiro %>
    <% if retiro.present? %>
      <div class="column is-12">
        <div class="labell">Ultimo retiro</div>
        <%= link_to bill_path(retiro), class: "" do %>
          <% if retiro.depositado? %>
            (Pagado)
          <% else %>
            (<%= retiro.status_pago %>)
          <% end %>
          <%= number_to_currency(retiro.total) %> - <%= retiro.folio %>
        <% end %>
      </div>
    <% end %>
    <% if @corp.spei? %>
      <div class="column is-6-mobile is-4-tablet is-4-desktop">
        <div class="labell">CLABE interbancaria</div>
        <p><%= @corp.banco_clabe %></p>
      </div>
      <div class="column is-6-mobile is-4-tablet is-4-desktop">
        <div class="labell">Beneficiario</div>
        <p><%= @corp.banco_beneficiario %></p>
      </div>
      <div class="column is-6-mobile is-4-tablet is-4-desktop">
        <div class="labell">Nombre del banco</div>
        <p><%= @corp.banco_nombre %></p>
      </div>
      <div class="column is-12">
        <% if @balance > Setting::MontoMinimoRetiro %>
          <%= button_to retiro_fondos_path, class: "button is-rounded is-fullwidth is-primary" do %>
            <span class="icon mr-1">
              <%= image_tag 'bolt.svg', alt: 'login' %>
            </span>
            Retirar fondos
          <% end %>
        <% else %>
          <div class="button is-rounded is-fullwidth is-primary" disabled>
            <span class="icon mr-1">
              <%= image_tag 'bolt.svg', alt: 'login' %>
            </span>
            Retirar fondos
          </div>
        <% end %>
        <div class="button is-rounded is-fullwidth is-info mt-4 mtrigger" data-target="spei_modal">
          <span class="icon mr-1">
            <%= image_tag 'document-add-svgrepo-com.svg', alt: 'login', class: 'invert' %>
          </span>
          Editar datos de cuenta SPEI
        </div>
      </div>
    <% else %>
      <div class="column is-12">
        <div class="labell">No tienes una cuenta SPEI asociada</div>
        <p>
          Para poder recibir pagos mediante SPEI, primero debes ingresar los datos de tu cuenta bancaria.
        </p>
      </div>
      <div class="column is-12">
        <div class="button is-rounded is-fullwidth is-primary" disabled>
          <span class="icon mr-1">
            <%= image_tag 'bolt.svg', alt: 'login' %>
          </span>
          Retirar fondos
        </div>
        <div class="button is-rounded is-fullwidth is-info mt-4 mtrigger" data-target="spei_modal">
          <span class="icon mr-1">
            <%= image_tag 'document-add-svgrepo-com.svg', alt: 'login', class: 'invert' %>
          </span>
          Ingresar datos de cuenta SPEI
        </div>
      </div>
    <% end %>
  </div>
</div>
<div id="spei_modal" class="modal">
  <div class="modal-background"></div>
  <div class="modal-content">
    <div class="box">
      <h3 class="title is-4">Datos de cuenta SPEI</h3>
      <%= form_with url: update_spei_path, method: :post  do |f| %>
        <div class="columns is-multiline">
          <div class="field column is-12">
            <label class="label">CLABE interbancaria <span class="has-text-danger">*</span></label>
            <div class="control">
              <%= f.text_field :banco_clabe, value: @corp.banco_clabe, class: 'input is-rounded', placeholder: '123456789012345678', required: true %>
            </div>
          </div>
          <div class="field column is-12">
            <label class="label">Nombre del beneficiario <span class="has-text-danger">*</span></label>
            <div class="control">
              <%= f.text_field :banco_beneficiario, value: @corp.banco_beneficiario, class: 'input is-rounded', placeholder: 'Nombre del beneficiario', required: true %>
            </div>
          </div>
        </div>
        <%= f.submit "Guardar", class: "button is-primary is-rounded is-fullwidth" %>
      <% end %>
    </div>
  </div>
  <button class="modal-close is-large" aria-label="close"></button>
</div>
<% if !@corp.suspendido? %>
  <div class="box">
    <div class="columns">
      <div class="column is-9">
        <h2>Comprar SMS</h2>
        <p>
          Adquiere paquetes de mensajes de texto para enviar recordatorios y notificaciones a tus clientes.
        </p>
      </div>
      <div class="column">
        <div class="button is-rounded is-fullwidth is-primary mtrigger" data-target="sms_modal">
          <span class="icon mr-1">
            <%= image_tag 'bolt.svg', alt: 'login' %>
          </span>
          Comprar
        </div>
        <div id="sms_modal" class="modal">
          <div class="modal-background"></div>
          <div class="modal-content">
            <div class="box">
              <h3 class="title is-4">Compra de SMS</h3>
              <% if @corp.stripe_payment_method_id.present? %>
                <% Setting::SmsPrices.each do |key, info| %>
                  <div class="box_box">
                    <div class="labell"><%= info[:name] %> <span class="tag is-rounded"><%= number_to_currency info[:unit_price] %> unidad</span></div>
                    <p class="contentt mb-2">
                      $<%= info[:price] %> MXN
                    </p>
                    <%= button_to charge_sms_path(cantidad: key), class: "button is-primary is-rounded is-fullwidth" do  %>
                      <span class="icon mr-1">
                        <%= image_tag 'circle-bottom-up-svgrepo-com.svg', alt: 'login' %>
                      </span>
                      Elegir
                    <% end %>
                  </div>
                <% end %>
              <% else %>
                <div class="box_box">
                  <div class="labell">No tienes una tarjeta asociada</div>
                  <p class="">
                    Para comprar SMS, primero debes asociar una tarjeta de crédito o débito a tu cuenta.
                  </p>
                  <%= button_to stripe_new_card_path, class: "button is-primary is-rounded is-fullwidth", data: {turbo: false} do  %>
                    <span class="icon mr-1">
                      <%= image_tag 'card-send-svgrepo-com.svg', alt: 'login' %>
                    </span>
                    Asociar tarjeta
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
          <button class="modal-close is-large" aria-label="close"></button>
        </div>
      </div>
    </div>
  </div>
  <% if @corp.facturacion? %>
    <div class="box">
      <div class="columns">
        <div class="column is-9">
          <h2>Comprar timbres</h2>
          <p>
            Adquiere timbres para emitir facturas electrónicas a tus clientes. Cada factura emitida consume un timbre.
          </p>
        </div>
        <div class="column">
          <div class="button is-rounded is-fullwidth is-primary mtrigger" data-target="timbre_modal">
            <span class="icon mr-1">
              <%= image_tag 'bolt.svg', alt: 'login' %>
            </span>
            Comprar
          </div>
          <div id="timbre_modal" class="modal">
            <div class="modal-background"></div>
            <div class="modal-content">
              <div class="box">
                <h3 class="title is-4">Cambiar plan</h3>
                <div class="noti is-danger">
                  <h2>
                    <span class="icon material-icons-round">warning</span>
                    Atención
                  </h2>
                  <p class="mt-2">El elegir un nuevo plan, se hara el cobro del monto correspondiente en tu tarjeta, y se te habilitaran las funciones del nuevo plan inmediatamente.</p>
                </div>
                <% if @corp.stripe_payment_method_id.present? %>
                  <% Setting::TimbrePrices.each do |key, info| %>
                    <div class="box_box">
                      <div class="labell"><%= info[:name] %> <span class="tag is-rounded"><%= number_to_currency info[:unit_price] %> unidad</span></div>
                      <p class="contentt">
                        $<%= info[:price] %> MXN
                      </p>
                      <%= button_to charge_timbres_path(cantidad: key), class: "button is-primary is-rounded is-fullwidth" do  %>
                        <span class="icon mr-1">
                          <%= image_tag 'circle-bottom-up-svgrepo-com.svg', alt: 'login' %>
                        </span>
                        Elegir
                      <% end %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="box_box">
                    <div class="labell">No tienes una tarjeta asociada</div>
                    <p class="">
                      Para cambiar de plan, primero debes asociar una tarjeta de crédito o débito a tu cuenta.
                    </p>
                    <%= button_to stripe_new_card_path, class: "button is-primary is-rounded is-fullwidth", data: {turbo: false} do  %>
                      <span class="icon mr-1">
                        <%= image_tag 'card-send-svgrepo-com.svg', alt: 'login' %>
                      </span>
                      Asociar tarjeta
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
            <button class="modal-close is-large" aria-label="close"></button>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
<%# ── Telegram ── %>
<div class="box expandable mt-4">
  <div class="box_header">
    <h2>
      <span class="icon mr-2">
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0m5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394a.76.76 0 0 1-.6.295h-.005l.213-3.054 5.56-5.023c.24-.213-.054-.334-.373-.121l-6.87 4.326-2.96-.924c-.64-.203-.658-.64.135-.954L17.06 7.28c.538-.196 1.006.128.832.941z"/></svg>
      </span>
      Notificaciones Telegram
    </h2>
    <span class="icon toggle_icon">
      <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
    </span>
  </div>
  <div class="box_content">
    <% if @corp.telegram_id.present? %>
      <p class="mb-3">
        <span class="tag is-success">Vinculado</span>
      </p>
      <p class="help mb-3">
        Vinculado el <%= l(@corp.telegram_linked_at, format: :short) %>
      </p>
      <%= link_to telegram_unlink_path, data: { turbo_method: :delete, turbo_confirm: "¿Desvincular Telegram?" }, class: "button is-small is-rounded is-danger" do %>
        Desvincular
      <% end %>
    <% else %>
      <p class="help mb-3">
        Recibe notificaciones de tu negocio directamente en Telegram.
      </p>
      <% if Rails.application.credentials.dig(:telegram, :bot_username).present? %>
        <div class="mb-3">
          <script async src="https://telegram.org/js/telegram-widget.js?22" data-telegram-login="<%= Rails.application.credentials.dig(:telegram, :bot_username) %>" data-size="medium" data-auth-url="<%= telegram_callback_url %>" data-request-access="write"></script>
        </div>
        <p class="has-text-centered text-gray mb-3" style="font-size: 0.8rem;">o</p>
      <% end %>
      <%= link_to telegram_link_corp_path, class: "button is-small is-rounded is-info" do %>
        <span class="icon is-small mr-1">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0m5.894 8.221-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394a.76.76 0 0 1-.6.295h-.005l.213-3.054 5.56-5.023c.24-.213-.054-.334-.373-.121l-6.87 4.326-2.96-.924c-.64-.203-.658-.64.135-.954L17.06 7.28c.538-.196 1.006.128.832.941z"/></svg>
        </span>
        Vincular vía bot
      <% end %>
    <% end %>
  </div>
</div>
