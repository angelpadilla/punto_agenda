<% content_for :title, "Inventario" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Mis productos</h2>
  <div class="actions">
    <%= link_to new_item_path, class: "button is-primary is-rounded" do  %>
      <span class="icon mr-2">
        <%= image_tag 'plus.svg', alt: 'carrito' %>
      </span>
      Nuevo producto
    <% end %>
    <div class="button is-rounded">
      <span class="icon">
        <%= image_tag 'wand.svg', alt: 'filter', class: 'invert' %>
      </span>
    </div>
    <div class="dropdown is-right is-hoverable">
      <div class="dropdown-trigger">
        <button class="button is-rounded" aria-haspopup="true">
          <span class="icon">
            <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
          </span>
          <span>Acciones</span>
        </button>
      </div>
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <%= link_to new_item_path, class: "dropdown-item" do  %>
            <span class="icon">
              <%= image_tag 'download.svg', alt: 'download', class: 'invert' %>
            </span>
            Exportar CSV
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<hr>
<%= search_form_for @q, url: items_path do |f| %>
  <div class="columns is-multiline">
    <div class="column is-3">
      <%= f.search_field :name_cont, class: 'is-rounded search_input', placeholder: 'Nombre' %>
    </div>
    <div class="column is-2">
      <%= f.search_field :sku_eq, placeholder: "SKU", class: "input is-rounded" %>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :brand_id_eq, options_for_select(@brands.map {|b| [b.name, b.id]}, @q.brand_id_eq), {prompt: "Marca"}, {class: ""} %>
      </div>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :cate_eq, options_for_select(Item.cates.collect {|k, v| [k.humanize,v]}, (params[:q] and !params[:q][:cate_eq].blank?) ? params[:q][:cate_eq] : nil), {prompt: "Categoria"}, {class: ""} %>
      </div>
    </div>
    <div class="column is-3">
      <div class="buttons">
        <%= f.submit 'Buscar', class: "button is-rounded is-primary" %>
        <%= link_to items_path, class: "button is-rounded has_tooltip" do  %>
          <span class="icon reset">
            <%= image_tag 'trash.svg', alt: 'clear', class: 'invert' %>
          </span>
          <div class="tooltip down">Limpiar busqueda</div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<div class="table_box">
  <div class="table_header flexx">
    <div class="table_cell"><%= sort_link(@q, :name, 'Nombre') %></div>
    <div class="table_cell"><%= sort_link(@q, :sku, 'SKU') %></div>
    <div class="table_cell"><%= sort_link(@q, :brand_id, 'Marca') %></div>
    <div class="table_cell"><%= sort_link(@q, :cate, 'Categoria') %></div>
    <div class="table_cell"><%= sort_link(@q, :price, 'Precio') %></div>
    <div class="table_cell"><%= sort_link(@q, :stock, "Inventario") %></div>
  </div>
  <div class="table_content">
    <%= render @items %>
  </div>
</div>
<% if @pagy.pages > 1 %>
  <br>
  <%== @pagy.series_nav(:bulma) %>
  <br>
<% end %>
<br>
<br>