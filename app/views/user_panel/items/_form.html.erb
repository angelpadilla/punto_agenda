  <%= form_with(model: item, data: { controller: 'form-item' }) do |form| %>
  <% if item.errors.any? %>
    <div class="notification is-warning">
      <h2 class="subtitle"><%= pluralize(item.errors.count, "error", "errores") %> impidieron que esta razon se guardara:</h2>
      <ul>
        <% item.errors.each do |error| %>
          <li><%= error.message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="box mt-4">
    <div class="image-grid">
      <% image_fields = @corp.basico? ? Item::ImageFields1 : Item::ImageFields2 %>
      <% image_fields.each_with_index do |(label, field), index| %>
        <div class="image-tile">
          <label class="image-tile__drop has-text-centered" for="<%= form.send(:field_id, field) %>">
            <span class="image-tile__title">
              <% if item.send(field).attached? && item.persisted? %>
                <%= image_tag item.send(field).variant(resize_to_limit: [400, 400]), alt: "Imagen #{index + 1}", class: 'image-tile__preview' %>
              <% else %>
                <%= label %>
              <% end %>
            </span>
            <span class="image-tile__subtitle"></span>
            <span class="image-tile__meta">JPG o PNG · max 5MB</span>
            <%= form.file_field field, class: "image-tile__input", accept: ".jpg,.jpeg,.png, .webp", data: { action: "change->form-item#previewImage" } %>
            <span class="image-tile__action">Seleccionar archivo</span>
          </label>
        </div>
      <% end %>
    </div>
    <div class="columns">
      <div class="column is-7">
        <div class="columns is-multiline">
          <%= t_field(form, :name, label: "Nombre", placeholder: "Ej. Laptop Lenovo ThinkPad") %>
          <%= t_field(form, :sku, label: "SKU (Identificador interno)", placeholder: "Ej. ABC12345", clas: "field column is-6") %>
          <div class="field column is-6">
            <%= form.label :sat_product_id, "*Clave producto SAT", class: "label" %>
            <div class="control <%= item.errors.include?(:sat_product_id) ? 'select-is-danger' : '' %>">
              <%= form.select :sat_product_id,
                options_for_select(item.sat_product ? [["#{item.sat_product.sku} – #{item.sat_product.name}", item.sat_product_id]] : []),
                { prompt: "Escribe para buscar en SAT...", required: field_required?(Item, :sat_product_id) },
                { "data-controller": "slimselect", class: "ss2", "data-ajax-url": search_sat_products_items_path(format: :json) }
              %>
              <p class="help">Empieza a escribir el código o nombre para buscar en SAT ...</p>
            </div>
          </div>
          <div class="field has-addons column is-12">
            <div class="control is-expanded <%= item.errors.include?(:brand_id) ? 'select-is-danger' : '' %>">
              <%= form.select :brand_id, options_for_select(Brand.default.map { |k| [k.name&.titleize, k.id] }, item.brand_id),
                {prompt: "Selecciona Marca", required: field_required?(Item, :brand_id)},
                { "data-controller": "slimselect", class: "ss2"}
                %>
            </div>
            <div class="control">
              <div class="button mtrigger" data-target="new_brand">
                <span class="icon">
                  <%= image_tag 'plus.svg', alt: 'new-brand', class: 'invert' %>
                </span>
              </div>
            </div>
          </div>
          <%= s_field(form, :unidad, options: Item::UnidadSAT, label: "Unidad", clas: "field column is-6") %>
          <%= s_field(form, :cate, options: Item.cates.keys.map { |k| [k.humanize, k] }, label: "Categoria", clas: "field column is-6") %>
          <%= a_field(form, :desc, label: "Descripción", placeholder: "Descripción del item") %>
          <%= t_field(form, :garantia, label: "Garantía o términos y condiciones de tu producto", placeholder: "Ej. 1 año de garantía") %>
        </div>
      </div>
      <div class="column is-5">
        <div class="columns is-multiline">
          <%= n_field(form, :price, label: "Precio", clas: "field column is-6") %>
          <%= n_field(form, :offer, label: "Precio oferta", clas: "field column is-6") %>
          <%= n_field(form, :cost, label: "Costo", clas: "field column is-12") %>
          <%= s_field(form, :status, options: Item::Statuses, label: "Status") %>
          <%= n_field(form, :stock, label: "Inventario (deja en blanco si es ilimitado)") %>
          <%= n_field(form, :alerta_stock, label: "Alerta inventario bajo", placeholder: "Ej. 10") %>
        </div>
      </div>
    </div>
    <br>
    <p>* Campos obligatorios</p>
  </div>
  <div class="field is-grouped is-justify-content-space-between mt-5">
    <div class="control">
      <%= link_to "Cancelar", items_path, class: "button is-rounded" %>
    </div>
    <div class="control">
      <%= form.submit "Guardar", class: "button is-rounded is-primary" %>
    </div>
  </div>
<% end %>
<%# modals %>
<div id="new_brand" class="modal">
  <div class="modal-background"></div>
  <div class="modal-content">
    <div class="box">
      <h3 class="title is-4">Crear nueva marca</h3>
      <div id="brand-form-errors"></div>
      <%= form_with(model: Brand.new, url: create_from_item_brands_path, format: :turbo_stream) do |f| %>
        <div class="columns is-multiline">
          <%= t_field(f, :name, placeholder: "Nombre de la marca") %>
        </div>
        <%= f.submit "Guardar", class: "button is-primary is-fullwidth is-rounded" %>
      <% end %>
    </div>
  </div>
  <button class="modal-close is-large" aria-label="close"></button>
</div>