<% content_for :title, "Editar item" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Edición de item</h2>
  <div class="actions">
    <%= link_to items_path, class: "button is-rounded mr-2" do %>
      <span class="icon mr-2">
        <%= image_tag 'items.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver a listado
    <% end %>
    <%= link_to item_path(@item), class: "button is-rounded" do %>
      <span class="icon mr-2">
        <%= image_tag 'eye.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver a item
    <% end %>
  </div>
</div>
<%= render 'form', item: @item %>