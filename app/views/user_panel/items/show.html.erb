<% content_for :title, "Detalle del Producto" %>
<div data-controller="show-item">
  <div class="flexx space-b flex-end">
    <h2 class="titlee">Detalle de item</h2>
    <div class="actions">
      <%= link_to items_path, class: "button is-rounded mr-2" do %>
        <span class="icon mr-2">
          <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
        </span>
        Volver a listado 
      <% end %>
      <%= link_to edit_item_path(@item), class: "button is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'edit.svg', alt: 'editar', class: "invert" %>
        </span>
        Editar
      <% end %>
    </div>
  </div>
  <div class="box mt-4">
    <div class="columns is-multiline">
      <!-- imágenes -->
      <div class="column is-5">
        <% images = [@item.img1, @item.img2, @item.img3, @item.img4, @item.img5].select(&:attached?) %>
        <% if images.any? %>
          <section class="splide mb-4" aria-label="Splide Basic HTML Example">
            <div class="splide__track">
              <ul class="splide__list">
                <% if images.any? %>
                  <% images.each do |img| %>
                    <li class="splide__slide">
                      <%= image_tag img.variant(resize_to_limit: [600, 600]), loading: "lazy" %>
                    </li>
                  <% end %>
                <% else %>
                  <li class="splide__slide image">
                    Item sin imágenes
                  </li>
                <% end %>
              </ul>
            </div>
          </section>
          <section class="splide splide_thumbnail_carousel" aria-label="Splide Basic HTML Example">
            <div class="splide__track">
              <ul class="splide__list">
                <% images = [@item.img1, @item.img2, @item.img3, @item.img4, @item.img5].select(&:attached?) %>
                <% images.each do |img| %>
                  <li class="splide__slide">
                    <%= image_tag img.variant(resize_to_limit: [600, 600]), loading: "lazy" %>
                  </li>
                <% end %>
              </ul>
            </div>
          </section>
        <% else %>
          <div class="no_image_item_show">
            <%= image_tag 'items.svg', alt: 'item', class: 'invert', loading: 'lazy' %>
          </div>
        <% end %>
      </div>
      <!-- Columna de información -->
      <div class="column is-7">
        <div class="tags">
          <% if @item.activo? %>
            <span class="tag is-info is-rounded"><%= @item.status.titleize %></span>
          <% else %>
            <span class="tag is-danger is-light is-rounded"><%= @item.status.titleize %></span>
          <% end %>
          <% if @item.offer.present? %>
            <span class="tag is-warning is-light is-rounded">Oferta</span>
          <% end %>
        </div>
        <h3 class="titlee2 is-3 mb-4"><%= @item.name %></h3>
        <div class="columns is-multiline is-mobile mb-4">
          <!-- Precios -->
          <div class="column is-4">
            <div class="labell">Precio</div>
            <p class="contentt <%= @item.offer.present? ? 'tacha' : 'has-text-primary' %>"><%= number_to_currency(@item.price) %></p>
          </div>
          <div class="column is-4">
            <div class="labell">Oferta</div>
            <p class="contentt <%= @item.offer.present? ? 'has-text-primary' : '' %>"><%= @item.offer.present? && @item.offer > 0 ? number_to_currency(@item.offer) : '-' %></p>
          </div>
          <div class="column is-4">
            <div class="labell">Costo</div>
            <p class="contentt"><%= @item.cost.present? && @item.cost > 0 ? number_to_currency(@item.cost) : '-' %></p>
          </div>
          <div class="column is-6">
            <div class="labell">Marca</div>
            <p class="contentt"><%= @item.brand&.name %></p>
          </div>
          <div class="column is-6">
            <div class="labell">SKU</div>
            <p class="contentt"><%= @item.sku %></p>
          </div>
          <div class="column is-6">
            <div class="labell">Categoria</div>
            <p class="contentt"><%= @item.cate&.titleize %></p>
          </div>
          <div class="column is-6">
            <div class="labell">Inventario</div>
            <p class="contentt">
              <% if @item.stock %>
                <% if @item.stock < @item.alerta_stock %>
                  <span class="has-text-danger"><%= @item.stock %></span>
                <% else %>
                  <%= @item.stock %>
                <% end %>
              <% else %>
                <span class="material-icons-round icon" loading="lazy">
                  all_inclusive
                </span>
              <% end %>
            </p>
          </div>
          <div class="column is-6">
            <div class="labell">Alerta inventario</div>
            <p class="contentt"><%= @item.alerta_stock || 'N/A' %></p>
          </div>
          <!-- Producto SAT -->
          <div class="column is-6">
            <p class="labell">Clave producto SAT</p>
            <p class="contentt">(<%= @item.sat_product.sku %>) <%= @item.sat_product&.name %></p>
          </div>
        </div>
        <div class="columns is-multiline is-mobile mb-4">
          <!-- orders count -->
          <div class="column is-6">
            <p class="labell">Ventas</p>
            <p class="contentt"><%= @item.orders_count %></p>
          </div>
        </div>
        <div class="columns is-multiline is-mobile mb-4">
          <!-- Notas o descripción adicional -->
          <div class="column is-12 mt-2">
            <p class="has-text-grey is-size-5">Descripción de item</p>
            <div class="content">
              <%= @item.desc.present? ? @item.desc : '-' %>
            </div>
          </div>
          <div class="column is-12 mt-2">
            <p class="has-text-grey is-size-5">Garantía o términos y condiciones de item</p>
            <div class="content">
              <%= @item.garantia.present? ? @item.garantia : '-' %>
            </div>
          </div>
          <div class="column is-6">
            <div class="labell">Fecha de creación</div>
            <p class="title is-6"><%= @item.created_at.strftime("%d/%m/%Y %H:%M") %></p>
          </div>
          <div class="column is-6">
            <div class="labell">Fecha ultima actualización</div>
            <p class="title is-6"><%= @item.updated_at.strftime("%d/%m/%Y %H:%M") %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
