<%= turbo_stream.update "compra_resumen", partial: "user_panel/purchases/compra_resumen", locals: { purchase: @purchase, source: params[:source] } %>
<% if @show_cart_button && @purchase.purchase_items.count > 0 %>
  <%= turbo_stream.append "compra_resumen", partial: "user_panel/purchases/cart_button", locals: { purchase: @purchase } %>
<% end %>
