<% content_for :title, "Mis Tickets de Soporte" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Mis Tickets de Soporte</h2>
  <div class="actions">
    <%= link_to new_user_ticket_path, class: "button is-primary is-rounded" do %>
      <span class="icon mr-2">
        <%= image_tag 'plus.svg', alt: 'nuevo' %>
      </span>
      Nuevo ticket
    <% end %>
  </div>
</div>
<hr>
<%= search_form_for @q, url: user_tickets_path do |f| %>
  <div class="columns is-multiline">
    <div class="column is-4">
      <%= f.search_field :title_or_description_cont, class: 'input is-rounded', placeholder: 'Buscar en mis tickets...' %>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :status_eq, Ticket.statuses.map { |k, v| [k.to_s.humanize, v] }, { include_blank: 'Status' } %>
      </div>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :category_eq, Ticket.categories.map { |k, v| [k.to_s.humanize, v] }, { include_blank: 'Categoría' } %>
      </div>
    </div>
    <div class="column is-3">
      <div class="buttons">
        <%= f.submit 'Buscar', class: "button is-rounded is-primary" %>
        <%= link_to user_tickets_path, class: "button is-rounded has_tooltip" do %>
          <span class="icon reset">
            <%= image_tag 'trash.svg', alt: 'clear', class: 'invert' %>
          </span>
          <div class="tooltip down">Limpiar busqueda</div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<div class="table_box">
  <div class="table_header flexx">
    <div class="table_cell"><%= sort_link(@q, :id, 'ID') %></div>
    <div class="table_cell"><%= sort_link(@q, :status, 'Status') %></div>
    <div class="table_cell"><%= sort_link(@q, :category, 'Categoría') %></div>
    <div class="table_cell"><%= sort_link(@q, :updated_at, 'Última actualización') %></div>
  </div>
  <div class="table_content">
    <%= render @tickets %>
  </div>
</div>
<% if @pagy.pages > 1 %>
  <br>
  <%== @pagy.series_nav(:bulma) %>
  <br>
<% end %>
