<% content_for :body_class, "blog_index" %>
<% set_page_meta(title: "Articulos", description: "Explora nuestros artículos y noticias") %>
<section class="heroo pad_top_nav" loading="lazy">
  <div class="container">
    <%= search_form_for @q, url: index_blog_path, class: "blog_search has-text-centered" do |f| %>
      <%= f.search_field :title_or_extract_cont, class: 'input is-rounded', placeholder: 'Busca por titulo o contenido' %>
    <% end %>
  </div>
</section>
<% if @posts.any? %>
  <section class="container articles">
    <div class="flexx space-b flex-end mb-4">
      <span class="tag is-success is-rounded">Recientes</span>
    </div>
    <div class="columns is-multiline is-mobile articles-grid">
      <% @posts.each do |item| %>
        <div class="column is-6-desktop is-6-tablet is-12-mobile">
          <%= link_to show_blog_path(item.slug), class: "is-full-height" do %>
            <div class="box cursor-pointer mb-4 is-article-card">
              <div>
                <span class="tag is-rounded is-info"><%= item.cate&.titleize %></span>
              </div>
              <% if item.url_image %>
                <div class="coverr" 
                style="background-image: linear-gradient(rgba(12, 12, 12, 0.7), rgba(12, 12, 12, 1)), url(<%= item.url_image %>); background-size: cover; background-position: top;"
              >
                </div>
              <% else %>
                <div class="coverr" 
              style="background-image: linear-gradient(rgba(12, 12, 12, 0.7), rgba(12, 12, 12, 1)), url(<%= (item.cover.attached? and item.cover.persisted?) ? url_for(item.cover.variant(:small)) : asset_path("blog_index.jpg") %>); background-size: cover; background-position: top;"
            >
                </div>
              <% end %>
              <h1 class="title is-4"><%= item.title.humanize %></h1>
              <p class="subtitle is-6 mt-2">
                <%= l(item.updated_at, format: :short) %>
                <% if item.source %>
                  | <%= item.source %>
                <% end %>
              </p>
              <div class="mt-2 extract">
                <%= item.extract %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if @pagy.pages > 1 %>
      <div class="mt-6 mb-6">
        <%== @pagy.series_nav(:bulma) %>
      </div>
    <% end %>
  </section>
<% else %>
  <section class="container articles">
    <div class="box has-text-centered">
      <h1 class="title is-4">No se encontraron artículos</h1>
      <p class="subtitle is-6">Intenta buscar con otra palabra clave</p>
    </div>
  </section>
<% end %>