<div class="container mt-5">
  <%# Breadcrumb %>
  <div class="flexx space-b flex-end">
    <h2 class="titlee">
      <span class="icon mr-2">
        <%= image_tag 'calendar.svg', alt: '', class: 'invert' %>
      </span>
      Detalle de pago y evento reservado
    </h2>
    <div class="actions">
      <%= link_to corp_home_path(@corp.sku), class: "button is-rounded mr-2" do %>
        <span class="icon mr-2">
          <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
        </span>
        Volver a <%= @corp.name %>
      <% end %>
      <div class="dropdown is-right is-hoverable">
        <div class="dropdown-trigger">
          <button class="button is-rounded" aria-haspopup="true">
            <span class="icon">
              <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
            </span>
            <span>Acciones</span>
          </button>
        </div>
        <div class="dropdown-menu" role="menu">
          <div class="dropdown-content">
            <%= link_to ticket_path(@order.folio), class: "dropdown-item" do %>
              <span class="icon">
                <%= image_tag 'download.svg', alt: 'download', class: 'invert' %>
              </span>
              PDF
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="noti is-main mt-4">
    Primar lorem ipsum dolor sit amet, consectetur adipiscing elit lorem ipsum
    dolor. <strong>Pellentesque risus mi</strong>, tempus quis placerat ut, porta
    nec nulla. Vestibulum rhoncus ac ex sit amet fringilla. Nullam gravida purus
    diam, et dictum <a>felis venenatis</a> efficitur.
  </div>
</div>
<div class="box">
  <%= @corp.to_json %>
</div>
<div class="box">
  <%= @event.to_json %>
</div>
<div class="box">
  <%= @order.to_json %>
</div>
<div class="box">
  <%= @customer.to_json %>
</div>
<div class="box">
  <%= @deposit.to_json %>
</div>
<div class="box">
  <%= @payment_intent.to_json %>
</div>
