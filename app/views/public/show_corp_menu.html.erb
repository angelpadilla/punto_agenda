<div class="container mt-5">
  <%# Breadcrumb %>
  <div class="flexx space-b flex-end">
    <h2 class="titlee">
      <span class="icon mr-2">
        <%= image_tag 'items.svg', alt: '', class: 'invert' %>
      </span>
      Catálogo
    </h2>
    <div class="actions">
      <%= link_to corp_home_path(@corp.sku), class: "button is-rounded mr-2" do %>
        <span class="icon mr-2">
          <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
        </span>
        Volver a <%= @corp.name %>
      <% end %>
    </div>
  </div>
  <%# Filtros por categoría %>
  <div class="tags mb-5 mt-4">
    <span class="tag is-rounded is-medium corp_cate_tag <%= 'is-primary' if @cate_filter.nil? %>">
      <%= link_to 'Todo', corp_menu_path(@corp.sku), class: 'has-text-inherit' %>
    </span>
    <% Item.cates.each do |cate_name, cate_val| %>
      <span class="tag is-rounded is-medium corp_cate_tag <%= 'is-primary' if @cate_filter == cate_val.to_s %>">
        <%= link_to cate_name.titleize, corp_menu_path(@corp.sku, cate: cate_val), class: 'has-text-inherit' %>
      </span>
    <% end %>
  </div>
  <% if @items.any? %>
    <div class="columns is-multiline">
      <%= render partial: 'shared/item', collection: @items, as: :item %>
    </div>
  <% else %>
    <div class="box has-text-centered py-6">
      <p class="has-text-grey-light is-size-5">No hay productos disponibles en esta categoría</p>
    </div>
  <% end %>
</div>
