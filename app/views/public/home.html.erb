<%# caracteristicas %>
<section class="sCaracteristicas mt-6 container" id="ventajas">
  <div class="box is-black">
    <div class="sCaracteristicas__content">
      <p class="tag is-success is-rounded mb-4">Ventas</p>
      <h2 class="title is-2">
        Catálogo digital
      </h2>
      <p class="subtitle text-gray mt-6">
        Comparte tu tienda en redes sociales con un link o código QR, llega a más clientes y vende más.
      </p>
      <p class="subtitle text-gray">Crea tu catálogo digital con fotos, descripciones y precios.</p>
      <p class="subtitle text-gray">Administra tus ventas de manera eficiente. Mantén un registro de tus transacciones y asegura una experiencia organizada para tus clientes.</p>
    </div>
    <%= image_tag 'items.svg', alt: 'catalogo', class: 'sCaracteristicas__image' %>
  </div>
</section>
<section class="sCaracteristicas mt-6 container">
  <div class="box is-black">
    <div class="sCaracteristicas__content">
      <p class="tag is-success is-rounded mb-4">Citas y eventos</p>
      <h2 class="title is-2">
        Gestión de citas y eventos
      </h2>
      <p class="subtitle mt-4 text-gray">Administra tus citas y eventos de manera eficiente. Mantén un registro de tus compromisos y asegura una experiencia organizada para tus clientes.</p>
      <p class="subtitle text-gray">Comparte tu agenda para que tus clientes puedan ver tu disponibilidad y reservar citas fácilmente.</p>
      <p class="subtitle text-gray">Avisa tus citas y eventos con tus clientes a través de notificaciones y recordatorios.</p>
    </div>
    <%= image_tag 'calendar.svg', alt: 'gestión de eventos y citas', class: 'sCaracteristicas__image' %>
  </div>
</section>
<section class="sCaracteristicas mt-6 container">
  <div class="box is-black">
    <div class="csCaracteristicas__content">
      <p class="tag is-success is-rounded mb-4">Clientes</p>
      <h2 class="title is-2">
        Gestión de clientes
      </h2>
      <p class="subtitle text-gray mt-4">Administra la información de tus clientes de manera eficiente. Mantén un registro de tus clientes y asegura una experiencia organizada para ellos.</p>
    </div>
    <%= image_tag 'cup.svg', alt: 'gestión de clientes', class: 'sCaracteristicas__image' %>
  </div>
</section>
