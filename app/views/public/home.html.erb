<section class="sIntro flexx horizontal-center vertical-center">
  <div class="inner">
    <div>
      <div class="avatar-group">
        <% 10.times do |index| %>
          <div class="avatar">
            <%= image_tag "https://api.dicebear.com/10.x/micah/svg?backgroundColor=bdf5df&mouthVariant=laughing,pucker,smile,smirk,surprised&seed=#{index}", loading: "lazy" %>
          </div>
        <% end %>
      </div>
      <p class="text-gray mt-2"><span class="has-text-white">100+</span> negocios ya venden con miinegocio</p>
    </div>
    <h1 class="mt-4 ptitle">
      Manejo de
      <span class="has-text-neon">citas, eventos, ventas, compras, inventario</span>.
    </h1>
    <h2 class="psubtitle text-gray mt-5 mb-6">
      Controla tu negocio, que no te controle a ti.
    </h2>
    <% if current_user %>
      <%= link_to user_panel_home_path, class: "button is-primary is-rounded mr-4" do %>
        <span class="icon mr-2">
          <%= image_tag 'shop.svg', alt: 'login' %>
        </span>
        Panel de control
      <% end %>
    <% else %>
      <%= link_to new_user_session_path, class: "button is-primary is-rounded mr-4" do %>
        <span class="icon mr-2">
          <%= image_tag 'login.svg', alt: 'login' %>
        </span>
        Acceder
      <% end %>
      <%= link_to new_user_registration_path, class: "button is-info is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'login.svg', alt: 'registro', class: 'invert' %>
        </span>
        Registrarse
      <% end %>
    <% end %>
  </div>
</section>
