<% if false %>
  <%# articulos destacados %>
  <section class="container mt-6">
    <div class="flexx space-b flex-end mb-4">
      <span class="tag is-success is-rounded">Tutoriales esenciales</span>
    </div>
    <div class="columns is-multiline is-mobile articles-grid">
      <% @last_articles.each do |item| %>
        <div class="column is-6-desktop is-6-tablet is-12-mobile">
          <%= link_to show_blog_path(item.slug), class: "is-full-height" do %>
            <div class="box cursor-pointer mb-4 is-article-card">
              <div>
                <span class="tag is-rounded is-info"><%= item.cate&.titleize %></span>
              </div>
              <div class="coverr" 
                style="background-image: linear-gradient(rgba(12, 12, 12, 0.7), rgba(12, 12, 12, 1)), url(<%= (item.cover.attached? and item.cover.persisted?) ? url_for(item.cover.variant(:small)) : asset_path("blog_index.jpg") %>); background-size: cover; background-position: top;">
              </div>
              <h1 class="title is-4"><%= item.title.humanize %></h1>
              <p class="subtitle is-6 mt-2">
                <%= l(item.updated_at, format: :short) %>
              </p>
              <div class="mt-2 extract">
                <%= item.extract %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
