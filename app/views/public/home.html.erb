<section class="s1 flexx justify-center vertical-center">
  <div class="inner">
    <div>
      <p class="text-gray">50+ negocio ya venden con miinegocio</p>
    </div>
    <h1 class="title is-1 mt-4">
      Administra
      <span class="has-text-neon">citas, eventos, ventas, compras, clientes, inventario</span>.
      <br>
      Vende
      <span class="has-text-neon">online</span>
      desde un mismo lugar
    </h1>
    <h2 class="subtitle text-gray mt-5">
      Crea tu catálogo, comparte tu tienda, gestiona tus ventas y citas desde un mismo lugar.
    </h2>
    <% if user_signed_in? %>
      <%= link_to user_panel_home_path, class: "button is-primary is-rounded mr-4" do %>
        <span class="icon mr-2">
          <%= image_tag 'shop.svg', alt: 'login' %>
        </span>
        Acceder
      <% end %>
    <% else %>
      <%= link_to new_user_session_path, class: "button is-primary is-rounded mr-4" do %>
        <span class="icon mr-2">
          <%= image_tag 'login.svg', alt: 'login' %>
        </span>
        Acceder
      <% end %>
      <%= link_to new_user_registration_path, class: "button is-info is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'login.svg', alt: 'registro', class: 'invert' %>
        </span>
        Registrarse
      <% end %>
    <% end %>
  </div>
</section>
