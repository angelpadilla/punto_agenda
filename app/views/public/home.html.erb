<section class="container" data-controller="splide" data-splide-autoplay="true" data-splide-type="loop" data-splide-pagination="true" data-splide-arrows="false" data-splide-click-to-go="true">
  <div class="flexx space-b flex-end mb-4">
    <span class="tag is-success is-rounded">Usos</span>
    <div class="splide__arrows splide__arrows--custom">
      <button class="button is-small is-rounded splide__arrow--prev" data-action="click->splide#prev" aria-label="Anterior">
        <span class="icon is-small">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </span>
      </button>
      <button class="button is-small is-rounded splide__arrow--next" data-action="click->splide#next" aria-label="Siguiente">
        <span class="icon is-small">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </span>
      </button>
    </div>
  </div>
  <div class="splide splide_home">
    <div class="splide__track">
      <ul class="splide__list">
        <% tipos.each do |key, tipo| %>
          <li class="splide__slide cursor-pointer">
            <%= image_tag "#{key}.jpg", alt: tipo[:title], loading: "lazy" %>
            <div class="splide_info">
              <h3 class="title is-4"><%= tipo[:title] %></h3>
              <p class="subtitle is-6"><%= tipo[:description] %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section>
