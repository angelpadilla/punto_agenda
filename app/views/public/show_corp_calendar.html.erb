<div class="container mt-5">
  <%# Breadcrumb %>
  <div class="flexx space-b flex-end">
    <h2 class="titlee">
      <span class="icon mr-2">
        <%= image_tag 'calendar.svg', alt: '', class: 'invert' %>
      </span>
      Selecciona tu horario
    </h2>
    <div class="actions">
      <%= link_to corp_home_path(@corp.sku), class: "button is-rounded mr-2" do %>
        <span class="icon mr-2">
          <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
        </span>
        Volver a <%= @corp.name %>
      <% end %>
    </div>
  </div>
  <div class="box mt-4">
    <div class="mt-4">
      <p class="has-text-grey-light is-size-7 mb-4">
        Haz clic en un horario disponible para elegir agente y continuar con tu reserva.
      </p>
      <div class="is-hidden-touch pub_calendar">
        <%= calendar(number_of_days: 7) do |date| %>
          <%= render 'public_calendar_day', date: date, info_day: @calendar_data[date], corp: @corp, identifier: 'd' %>
        <% end %>
      </div>
      <div class="is-hidden-desktop pub_calendar">
        <%= calendar(number_of_days: 3) do |date| %>
          <%= render 'public_calendar_day', date: date, info_day: @calendar_data[date], corp: @corp, identifier: 'm' %>
        <% end %>
      </div>
    </div>
  </div>
</div>
