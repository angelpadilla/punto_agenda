<div class="container mt-5">
  <%# Breadcrumb %>
  <div class="flexx space-b flex-end">
    <h2 class="titlee">
      <span class="icon mr-2">
        <%= image_tag 'calendar.svg', alt: '', class: 'invert' %>
      </span>
      Detalle de pago y reserva
    </h2>
    <div class="actions">
      <%= link_to corp_home_path(@corp.sku), class: "button is-rounded mr-2" do %>
        <span class="icon mr-2">
          <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
        </span>
        Volver a <%= @corp.name %>
      <% end %>
    </div>
  </div>
  <div class="noti is-danger mt-4">
    Tu reserva no se ha podido procesar correctamente. Por favor intenta nuevamente o contacta al soporte para obtener ayuda.
  </div>
</div>
