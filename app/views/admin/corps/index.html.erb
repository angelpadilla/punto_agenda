<% content_for :title, "Clientes" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Clientes</h2>
  <div class="actions">
    <div class="dropdown is-right is-hoverable">
      <div class="dropdown-trigger">
        <button class="button is-rounded" aria-haspopup="true">
          <span class="icon">
            <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
          </span>
          <span>Acciones</span>
        </button>
      </div>
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <%= link_to admin_corps_path, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'download.svg', alt: 'download', class: 'invert' %>
            </span>
            Exportar CSV
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<hr>
<%= search_form_for @q, url: admin_corps_path do |f| %>
  <div class="columns is-multiline">
    <div class="column is-3">
      <%= f.search_field :name_cont, class: 'is-rounded search_input', placeholder: 'Nombre' %>
    </div>
    <div class="column is-3">
      <%= f.search_field :sku_eq, class: 'is-rounded search_input', placeholder: 'SKU' %>
    </div>
    <div class="column is-3">
      <%= f.search_field :id_eq, class: 'is-rounded search_input', placeholder: 'ID' %>
    </div>
    <div class="column is-3">
      <div class="buttons">
        <%= f.submit 'Buscar', class: "button is-rounded is-primary" %>
        <%= link_to admin_corps_path, class: "button is-rounded has_tooltip" do %>
          <span class="icon reset">
            <%= image_tag 'trash.svg', alt: 'clear', class: 'invert' %>
          </span>
          <div class="tooltip down">Limpiar busqueda</div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<div class="table-container">
  <table class="table is-fullwidth is-hoverable mt-4">
    <thead>
      <tr>
        <th></th>
        <th><%= sort_link(@q, :ID, 'ID') %></th>
        <th><%= sort_link(@q, :name, 'Nombre') %></th>
        <th><%= sort_link(@q, :tipo_negocio, 'Tipo negocio') %></th>
        <th><%= sort_link(@q, :tipo_plan, 'Tipo plan') %></th>
        <th><%= sort_link(@q, :status, 'Status') %></th>
        <th><%= sort_link(@q, :created_at, 'Creacion') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render @corps %>
    </tbody>
  </table>
</div>
<% if @pagy.pages > 1 %>
  <br>
  <%== @pagy.series_nav(:bulma) %>
  <br>
<% end %>
<br>
<br>