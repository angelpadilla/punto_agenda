<% content_for :title, "Detalle de cliente" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Detalle de cliente</h2>
  <div class="actions">
    <%= link_to admin_corps_path, class: "button is-rounded" do %>
      <span class="icon mr-2">
        <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
      </span>
      Listado
    <% end %>
    <% if current_admin.admin? %>
      <%= link_to edit_admin_corp_path(@corp), class: "button is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'edit.svg', alt: 'editar', class: "invert" %>
        </span>
        Editar
      <% end %>
    <% end %>
    <div class="dropdown is-right is-hoverable">
      <div class="dropdown-trigger">
        <button class="button is-rounded" aria-haspopup="true">
          <span class="icon">
            <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
          </span>
        </button>
      </div>
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <%= link_to new_user_path, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'user.svg', alt: 'download', class: 'invert' %>
            </span>
            Equipo
          <% end %>
          <%= link_to admin_bills_path(q: { corp_id_eq: @corp.id }), class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'dollar.svg', alt: 'download', class: 'invert' %>
            </span>
            Facturación
          <% end %>
          <%= link_to new_user_path, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'layers.svg', alt: 'layers', class: 'invert' %>
            </span>
            Listado de marcas
          <% end %>
          <%= link_to new_user_path, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'layers.svg', alt: 'layers', class: 'invert' %>
            </span>
            Listado de ventas
          <% end %>
          <%= link_to new_user_path, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'layers.svg', alt: 'layers', class: 'invert' %>
            </span>
            Listado de eventos
          <% end %>
          <% if current_admin.super? %>
            <%= button_to extend_prueba_admin_corp_path(@corp), method: :post, class: "dropdown-item" do %>
              <span class="icon">
                <%= image_tag 'wand.svg', alt: 'settings', class: 'invert' %>
              </span>
              Extender prueba
            <% end %>
            <%= button_to destroy_corp_admin_corp_path(@corp), method: :post, data: {turbo_confirm: "Estas seguro?"}, class: "dropdown-item" do %>
              <span class="icon">
                <%= image_tag 'danger-triangle-svgrepo-com.svg', alt: 'settings', class: 'invert' %>
              </span>
              Eliminar cliente
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="columns is-mobile is-multiline mt-4">
  <div class="column is-9-desktop is-12-tablet is-12-mobile">
    <div class="box expandable is_active">
      <div class="box_header">
        <h2>
          <span class="icon mr-2">
            <%= image_tag 'user_data.svg', alt: "Datos principales", class: 'invert' %>
          </span>
          Datos principales
        </h2>
        <span class="icon toggle_icon">
          <%= image_tag 'down.svg', alt: "toggle open", class: 'invert' %>
        </span>
      </div>
      <div class="box_content">
        <div class="columns is-multiline is-mobile">
          <div class="column is-12">
            <div class="labell">Nombre</div>
            <p><%= @corp.name %></p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Email</div>
            <p><%= @corp.email %></p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Tel</div>
            <p><%= @corp.full_tel %></p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">ID tienda</div>
            <p><%= @corp.sku %>-<%= @corp.id %></p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Descuento</div>
            <p>
              <% if @corp.discount.positive? %>
                - <%= number_to_currency(@corp.discount) %>
              <% else %>
                —
              <% end %>
            </p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">SMS</div>
            <p><%= @corp.sms %></p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Timbres</div>
            <p><%= @corp.timbres %></p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Calendario?</div>
            <p>
              <% if @corp.calendar %>
                <span class="icon material-icons-round has-text-success">check_circle</span>
              <% else %>
                <span class="icon material-icons-round has-text-danger">cancel</span>
              <% end %>
            </p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Facturacion?</div>
            <p>
              <% if @corp.facturacion %>
                <span class="icon material-icons-round has-text-success">check_circle</span>
              <% else %>
                <span class="icon material-icons-round has-text-danger">cancel</span>
              <% end %>
            </p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Pagos en línea?</div>
            <p>
              <% if @corp.online_payments %>
                <span class="icon material-icons-round has-text-success">check_circle</span>
              <% else %>
                <span class="icon material-icons-round has-text-danger">cancel</span>
              <% end %>
            </p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Calendario publico?</div>
            <p>
              <% if @corp.public_calendar %>
                <span class="icon material-icons-round has-text-success">check_circle</span>
              <% else %>
                <span class="icon material-icons-round has-text-danger">cancel</span>
              <% end %>
            </p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Catalogo publico?</div>
            <p>
              <% if @corp.public_site %>
                <span class="icon material-icons-round has-text-success">check_circle</span>
              <% else %>
                <span class="icon material-icons-round has-text-danger">cancel</span>
              <% end %>
            </p>
          </div>
          <div class="column is-4-desktop is-6-tablet is-12-mobile">
            <div class="labell">Tarjeta asociada?</div>
            <p>
              <% if @corp.stripe_payment_method_id.present? %>
                <span class="icon material-icons-round has-text-success">check_circle</span>
              <% else %>
                <span class="icon material-icons-round has-text-danger">cancel</span>
              <% end %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="column is-3-desktop is-12-tablet is-12-mobile">
    <div class="box">
      <div class="box_header">
        <h2>
          <span class="icon mr-2">
            <%= image_tag 'shield-star-svgrepo-com.svg', alt: "Permisos", class: 'invert' %>
          </span>
          Información adicional
        </h2>
      </div>
      <div class="box_content">
        <div>
          <div class="labell">Tipo de negocio</div>
          <p class="">
            <%= @corp.tipo_negocio.titleize %>
          </p>
        </div>
        <div class="mt-4">
          <div class="labell">Tipo de plan</div>
          <p class="">
            <%= @corp.tipo_plan.titleize %>
          </p>
        </div>
        <div class="mt-4">
          <div class="labell">Status</div>
          <p class="">
            <% if @corp.activo? %>
              <span class="tag is-rounded is-success"><%= @corp.status.humanize %></span>
            <% elsif @corp.moroso? %>
              <span class="tag is-rounded is-danger"><%= @corp.status.humanize %></span>
            <% elsif @corp.probando? %>
              <span class="tag is-rounded is-warning"><%= @corp.status.humanize %></span>
            <% elsif @corp.suspendido? %>
              <span class="tag is-rounded is-danger"><%= @corp.status.humanize %></span>
            <% else %>
              <span class="tag is-rounded"><%= @corp.status.humanize %></span>
            <% end %>
          </p>
        </div>
        <div class="mt-4">
          <div class="labell">Balance</div>
          <p class="">
            <%= number_to_currency(@corp.balance) %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
