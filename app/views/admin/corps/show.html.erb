<%# show horarios de atencion %>
<% if @corp.calendar %>
  <div class="box expandable">
    <div class="box_header">
      <h2>
        <span class="icon mr-2">
          <%= image_tag 'calendar.svg', alt: "Horarios de atención", class: "invert" %>
        </span>
        Horarios de atención
      </h2>
      <span class="icon toggle_icon">
        <%= image_tag 'down.svg', alt: "toggle icon", class: 'invert' %>
      </span>
    </div>
    <div class="box_content">
      <table class="table is-fullwidth">
        <thead>
          <tr>
            <th>Día</th>
            <th>Abierto</th>
            <th>Espacios / Horarios</th>
          </tr>
        </thead>
        <tbody>
          <% Corp::DAYS_OF_WEEK.each do |wday, day_name| %>
            <% day_config = @corp.business_hours&.dig(wday) || { "active" => false, "hours" => [ { "open" => "09:00", "close" => "18:00" } ] } %>
            <% is_active = ActiveModel::Type::Boolean.new.cast(day_config["active"]) %>
            <% hours_list = day_config["hours"].presence || [] %>
            <tr>
              <td><strong><%= day_name %></strong></td>
              <td>
                <% if is_active %>
                  <span class="tag is-rounded is-success is-light">Abierto</span>
                <% else %>
                  <span class="tag is-rounded is-light">Cerrado</span>
                <% end %>
              </td>
              <td>
                <% if is_active && hours_list.any? %>
                  <% hours_list.each do |h| %>
                    <span class="tag is-info is-light mr-1"><%= h["open"] %> – <%= h["close"] %></span>
                  <% end %>
                <% else %>
                  <span class="has-text-grey">-</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <div class="columns is-multiline is-mobile mt-3">
        <% if @corp.online_payments and  @corp.public_calendar %>
          <div class="column is-6-desktop is-12-mobile">
            <div class="labell">Monto minimo para agendar</div>
            <p><%= number_to_currency(@corp.min_book_amount) %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
