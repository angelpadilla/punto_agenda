<% content_for :title, "Clientes" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Clientes</h2>
  <div class="actions">
    <% if current_admin.admin? %>
      <%= link_to new_admin_admin_path, class: "button is-primary is-rounded" do %>
        <span class="icon mr-2">
          <%= image_tag 'plus.svg', alt: 'nuevo usuario' %>
        </span>
        Nuevo usuario
      <% end %>
    <% end %>
    <div class="dropdown is-right is-hoverable">
      <div class="dropdown-trigger">
        <button class="button is-rounded" aria-haspopup="true">
          <span class="icon">
            <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
          </span>
          <span>Acciones</span>
        </button>
      </div>
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <%= link_to admin_admins_path, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'download.svg', alt: 'download', class: 'invert' %>
            </span>
            Exportar CSV
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<hr>
<%= search_form_for @q, url: admin_admins_path do |f| %>
  <div class="columns is-multiline">
    <div class="column is-4">
      <%= f.search_field :full_name, class: 'is-rounded search_input', placeholder: 'Nombre' %>
    </div>
    <div class="column is-2">
      <%= f.search_field :full_name, class: 'is-rounded input ', placeholder: 'ID' %>
    </div>
    <div class="column is-2">
      <div class="select is-rounded">
        <%= f.select :rol_eq, Admin::Roles, {prompt: "Rol"}, {class: ""} %>
      </div>
    </div>
    <div class="column is-3">
      <div class="buttons">
        <%= f.submit 'Buscar', class: "button is-rounded is-primary" %>
        <%= link_to admin_admins_path, class: "button is-rounded has_tooltip" do %>
          <span class="icon reset">
            <%= image_tag 'trash.svg', alt: 'clear', class: 'invert' %>
          </span>
          <div class="tooltip down">Limpiar busqueda</div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<table class="table is-fullwidth is-hoverable mt-4">
  <thead>
    <tr>
      <th></th>
      <th><%= sort_link(@q, :id, 'ID') %></th>
      <th><%= sort_link(@q, :full_name, 'Nombre') %></th>
      <th><%= sort_link(@q, :email, 'email') %></th>
      <th><%= sort_link(@q, :rol, 'Rol') %></th>
      <th><%= sort_link(@q, :last_sign_in_ip, 'Ultima IP') %></th>
      <th><%= sort_link(@q, :created_at, 'Creacion') %></th>
      <th><%= sort_link(@q, :updated_at, 'Actualizacion') %></th>
    </tr>
  </thead>
  <tbody>
    <%= render @admins %>
  </tbody>
</table>
<% if @pagy.pages > 1 %>
  <br>
  <%== @pagy.series_nav(:bulma) %>
  <br>
<% end %>
<br>
<br>