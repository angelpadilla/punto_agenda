<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div class="notification is-warning">
      <h2 class="subtitle"><%= pluralize(post.errors.count, "error") %> impidieron que este articulo se guardara:</h2>
      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="box mt-4">
    <div class="columns is-multiline">
      <div class="column is-12">
        <div class="doc_input" data-controller="preview-image">
          <div class="image_preview">
            <% if post.cover.attached? && post.cover.persisted? %>
              <%= image_tag post.cover.variant(resize_to_limit: [400, 400]), alt: "Cover", class: 'doc_image_preview' %>
            <% end %>
          </div>
          <div class="doc_file_name"></div>
          <div class="doc_file_size">JPG o PNG · max 5MB</div>
          <%= form.file_field :cover, class: "doc_file_field", accept: ".png, .jpg, .jpeg", data: { action: "change->preview-image#previewDoc" } %>
          <span class="doc_action"><%= post.cover.attached? ? "Reemplaza" : "Selecciona" %> cover</span>
        </div>
      </div>
      <%= s_field(form, :cate, options: Post.cates.map {|k, v| [k.humanize, k]}, label: "Categoria", clas: "field column is-6") %>
      <%= s_field(form, :status, options: Post.statuses.map {|k, v| [k.to_s.humanize, k]}, label: "Estado", clas: "field column is-3") %>
      <%= t_field(form, :youtube_url, label: "Youtube URL", clas: "field column is-3") %>
      <%= t_field(form, :title, label: "Titulo (min 15 caracteres, max 250 caracteres)") %>
      <%= t_field(form, :extract, label: "Extracto (min 50 caracteres, max 550 caracteres)") %>
      <div class="field column is-12" data-controller="recurrence-toggle">
        <label class="checkbox is-rounded mt-3">
          <%= check_box_tag :schedule_later, "1", post.publish_at.present?, class: "mr-2", data: { action: "change->recurrence-toggle#toggle" } %>
          Programar para más tarde
        </label>
        <div class="mt-3" data-recurrence-toggle-target="fields" style="<%= 'display:none;' unless post.publish_at.present? %>">
          <label class="label">Fecha y hora de publicación</label>
          <%= form.datetime_local_field :publish_at, class: "input is-rounded", value: post.publish_at&.strftime("%Y-%m-%dT%H:%M") %>
        </div>
      </div>
      <div class="field column is-12 form_trix">
        <label class="label">Contenido</label>
        <% if post.errors.include?(:content) %>
          <%= form.rich_text_area :content %>
          <p class="help is-danger">
            <% post.errors.full_messages_for(:content).each do |mss| %>
              <%= mss %>.
            <% end %>
          </p>
        <% else %>
          <%= form.rich_text_area :content %>
        <% end %>
      </div>
    </div>
  </div>
  <div class="field is-grouped is-justify-content-space-between mt-5">
    <div class="control">
      <%= link_to "Cancelar", posts_path, class: "button is-rounded" %>
    </div>
    <div class="control">
      <%= form.submit "Guardar", class: "button is-rounded is-primary" %>
    </div>
  </div>
<% end %>
