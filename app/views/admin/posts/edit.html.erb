<% content_for :title, "Editar articulo" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Editar articulo</h2>
  <div class="actions">
    <%= link_to posts_path, class: "button is-rounded mr-2" do %>
      <span class="icon mr-2">
        <%= image_tag 'left.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver a listado
    <% end %>
    <%= link_to post_path(@post), class: "button is-rounded mr-2" do %>
      <span class="icon mr-2">
        <%= image_tag 'eye.svg', alt: 'volver', class: 'invert' %>
      </span>
      Volver a articulo
    <% end %>
  </div>
</div>
<%= render 'form', post: @post %>