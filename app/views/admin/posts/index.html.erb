<% content_for :title, "Articulos" %>
<div class="flexx space-b flex-end">
  <h2 class="titlee">Articulos</h2>
  <div class="actions">
    <%= link_to new_post_path, class: "button is-primary is-rounded" do %>
      <span class="icon mr-2">
        <%= image_tag 'plus.svg', alt: 'nueva marca' %>
      </span>
      Nuevo articulo
    <% end %>
    <div class="dropdown is-right is-hoverable">
      <div class="dropdown-trigger">
        <button class="button is-rounded" aria-haspopup="true">
          <span class="icon">
            <%= image_tag 'dots.svg', alt: 'actions', class: 'invert' %>
          </span>
          <span>Acciones</span>
        </button>
      </div>
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-content">
          <%= link_to admin_panel_home_path, class: "dropdown-item" do %>
            <span class="icon">
              <%= image_tag 'download.svg', alt: 'download', class: 'invert' %>
            </span>
            --
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<hr>
<%= search_form_for @q, url: posts_path do |f| %>
  <div class="columns is-multiline is-mobile">
    <div class="column is-2-desktop is-3-tablet is-3-mobile">
      <%= f.search_field :id_eq, class: 'is-rounded search_input', placeholder: 'ID' %>
    </div>
    <div class="column is-6-mobile is-3-desktop">
      <div class="control">
        <%= f.search_field :title_or_extract_cont, class: 'input is-rounded', placeholder: 'Titulo o resumen' %>
      </div>
    </div>
    <div class="column is-2-desktop is-3-tablet is-3-mobile">
      <div class="select is-rounded">
        <%= f.select :cate_eq, Post.cates.map { |k, v| [k.titleize, v] }, { include_blank: 'Categoría' } %>
      </div>
    </div>
    <div class="column is-3-desktop is-6-tablet is-6-mobile">
      <div class="buttons">
        <%= f.submit 'Buscar', class: "button is-rounded is-primary" %>
        <%= link_to posts_path, class: "button is-rounded has_tooltip" do %>
          <span class="icon reset">
            <%= image_tag 'trash.svg', alt: 'clear', class: 'invert' %>
          </span>
          <div class="tooltip down">Limpiar busqueda</div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<div class="table-container">
  <table class="table is-fullwidth is-hoverable mt-4">
    <thead>
      <tr>
        <th><%= sort_link(@q, :id, 'ID') %></th>
        <th><%= sort_link(@q, :cate, 'Categoria') %></th>
        <th><%= sort_link(@q, :title, 'Titulo') %></th>
        <th><%= sort_link(@q, :extract, 'Extracto') %></th>
        <th><%= sort_link(@q, :created_at, 'Creacion') %></th>
        <th><%= sort_link(@q, :updated_at, 'Actualizacion') %></th>
        <th><%= sort_link(@q, :visits, 'Visitas') %></th>
      </tr>
    </thead>
    <tbody>
      <%= render @posts %>
    </tbody>
  </table>
</div>
<% if @pagy.pages > 1 %>
  <br>
  <%== @pagy.series_nav(:bulma) %>
  <br>
<% end %>
<br>
<br>