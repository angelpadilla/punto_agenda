<% content_for :title, "Inicio de sesión usuario" %>
<div class="login">
  <div class="login_ad_box flexx-1">
    <div class="header">
      <div class="logo_container">
        <%= image_tag 'logo2.svg', alt: 'MiiNegocio', class: 'logo' %>
      </div>
      <%= link_to root_path, class: "button is-rounded is-success" do %>
        <span class="icon">
          <%= image_tag 'login.svg', alt: 'login' %>
        </span>
        <span>Regresar a inicio</span>
      <% end %>
    </div>
    <div class="footerr">
      ¿No tienes una cuenta? <%= link_to "Regístrate aquí", new_registration_path(resource_name), class: "has-text-success" %>
    </div>
    <div class="img_cont"></div>
  </div>
  <div class="login_box flexx-1">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: 'login_form' }) do |f| %>
      <div class="cf-turnstile" data-size='flexible' data-sitekey="<%= Rails.application.credentials.dig(Rails.env.to_sym, :turnstile, :site_key) %>"></div>
      <div class="login_box_textt">
        <div class="login_box_logo">
          <%= image_tag 'logo2.svg', alt: 'MiiNegocio', class: 'logo' %>
        </div>
        <div class="login_box_title">Inicia sesión </div>
        <div class="login_box_p">Potencia tu productividad</div>
      </div>
      <div class="field">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'input is-rounded', placeholder: 'Email', required: true %>
      </div>
      <div class="field">
        <%= f.password_field :password, autocomplete: "current-password", class: 'input is-rounded', placeholder: 'Contraseña', required: true %>
      </div>
      <button type="submit" class="button is-rounded is-primary is-fullwidth">
        <span class="icon mr-2">
          <%= image_tag 'login.svg', alt: 'login' %>
        </span>
        Iniciar sesión
      </button>
      <br>
      <% if devise_mapping.rememberable? %>
        <div class="field">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, 'Recuerdame' %>
        </div>
      <% end %>
      <hr>
      <div class="buttons">
        <%= link_to root_path, class: "button is-rounded is-link is-fullwidth" do %>
          <span class="icon mr-4">
            <%= image_tag 'google.svg', alt: 'Google' %>
          </span>
          Iniciar con Google
        <% end %>
        <%= link_to root_path, class: "button is-rounded is-link is-fullwidth mt-2" do %>
          <span class="icon mr-4">
            <%= image_tag 'apple.svg', alt: 'Apple' %>
          </span>
          Iniciar con Apple
        <% end %>
      </div>
      <%= render "users/shared/links" %>
    <% end %>
  </div>
</div>
